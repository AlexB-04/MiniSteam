# Copy to .env for local Docker usage. Do not commit the real .env file.
# SQL Server requires a strong password.
MINISTEAM_SA_PASSWORD=ChangeThis_StrongPassword123!

# Must be a Base64-encoded key containing at least 32 random bytes.
# Generate one with PowerShell:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
MINISTEAM_JWT_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
