<UserControl x:Class="MiniSteam.Desktop.Views.GameDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="48,34,48,60">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="← Back" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,22" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#0E141B" BorderBrush="#2A475E" BorderThickness="1" MinHeight="330" Margin="0,0,22,0">
                    <Image Source="{Binding Game.ImageUrl}" Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Game.ReleaseStatus}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                        <Border Background="#24435A" Padding="7,3" Margin="9,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOwned}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="IN LIBRARY" Foreground="#66C0F4" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding Game.Name}" Foreground="White" FontSize="31" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,6" />
                    <TextBlock Text="{Binding Game.DeveloperPublisherText}" Margin="0,0,0,12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Game.Description}" Foreground="#C7D5E0" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,16" />
                    <TextBlock Text="{Binding Game.GenreName}" Foreground="#66C0F4" Margin="0,0,0,10" />

                    <ItemsControl ItemsSource="{Binding Game.Tags}" Margin="0,0,0,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#22384C" BorderBrush="#2A475E" BorderThickness="1" Padding="7,4" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding}" Foreground="#9BD7F7" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal">
                        <Border Background="#4C6B22" Padding="8,5" Margin="0,0,8,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Game.ActiveDiscountPercent}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Game.DiscountText}" Foreground="#BEED52" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="{Binding Game.PriceText}" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <WrapPanel Margin="0,18,0,0">
                        <Button Content="{Binding CartActionText}"
                                Command="{Binding CartCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,8" />
                        <Button Content="{Binding WishlistActionText}"
                                Command="{Binding WishlistCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,8" />
                        <Button Content="Open trailer"
                                Command="{Binding OpenTrailerCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,8" />
                    </WrapPanel>

                    <TextBlock Text="{Binding ActionMessage}" Foreground="#9BD7F7" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,28,0,0">
                <TextBlock Text="SCREENSHOTS" Foreground="#66C0F4" FontSize="11" FontWeight="Bold" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Game.Screenshots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="265" Height="150" Margin="0,0,12,12" BorderBrush="#2A475E" BorderThickness="1" Background="#0E141B">
                                <Image Source="{Binding}" Stretch="UniformToFill" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#171D25" BorderBrush="#2A475E" BorderThickness="1" Padding="18" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="MINIMUM SYSTEM REQUIREMENTS" Foreground="#66C0F4" FontSize="11" FontWeight="Bold" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding Game.MinimumSystemRequirementsText}" TextWrapping="Wrap" LineHeight="19" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#171D25" BorderBrush="#2A475E" BorderThickness="1" Padding="18" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="RECOMMENDED SYSTEM REQUIREMENTS" Foreground="#66C0F4" FontSize="11" FontWeight="Bold" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding Game.RecommendedSystemRequirementsText}" TextWrapping="Wrap" LineHeight="19" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="4" Margin="0,32,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.95*" />
                    <ColumnDefinition Width="1.35*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#171D25" BorderBrush="#2A475E" BorderThickness="1" Padding="18" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ReviewEditorTitle}" Foreground="#66C0F4" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="{Binding ReviewHintText}" Margin="0,7,0,12" TextWrapping="Wrap" />
                        <TextBox Text="{Binding ReviewText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"
                                 MinHeight="110"
                                 MaxLength="2000"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                        <CheckBox Content="I recommend this game"
                                  IsChecked="{Binding MyReviewRecommended}"
                                  Foreground="#C7D5E0"
                                  Margin="0,12,0,12" />
                        <WrapPanel>
                            <Button Content="{Binding ReviewButtonText}"
                                    Command="{Binding SaveReviewCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,8,8" />
                            <Button Content="Delete review"
                                    Command="{Binding DeleteReviewCommand}"
                                    Margin="0,0,8,8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMyReview}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="{Binding ReviewMessage}" Foreground="#9BD7F7" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#171D25" BorderBrush="#2A475E" BorderThickness="1" Padding="18" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="USER REVIEWS" Foreground="#66C0F4" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="{Binding ReviewSummaryText}" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,14" />
                        <ItemsControl ItemsSource="{Binding Reviews}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#10151D" BorderBrush="#2A475E" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding RecommendationText}" Foreground="#66C0F4" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding DateText}" FontSize="10" />
                                            </Grid>
                                            <TextBlock Text="{Binding Content}" Foreground="#C7D5E0" TextWrapping="Wrap" Margin="0,8,0,10" />
                                            <WrapPanel>
                                                <Button Content="{Binding HelpfulText}"
                                                        Command="{Binding DataContext.VoteHelpfulCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="8,4"
                                                        Margin="0,0,6,0" />
                                                <Button Content="{Binding NotHelpfulText}"
                                                        Command="{Binding DataContext.VoteNotHelpfulCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="8,4" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,22,0,0" TextWrapping="Wrap" />
        </Grid>
    </ScrollViewer>
</UserControl>
