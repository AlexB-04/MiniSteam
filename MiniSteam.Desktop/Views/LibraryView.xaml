<UserControl x:Class="MiniSteam.Desktop.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,30,28,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="YOUR GAMES" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="Library" Foreground="White" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,4" />
                    <TextBlock Text="Owned games can now be downloaded, installed and launched by MiniSteam Desktop." />
                    <TextBlock Text="{Binding InstallRootText}" Foreground="#66C0F4" FontSize="11" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" />
            </Grid>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Games}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="320"
                                MinHeight="365"
                                Margin="0,0,14,14"
                                Background="#1B2838"
                                BorderBrush="#2A475E"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="164" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0"
                                        Padding="0"
                                        BorderThickness="0"
                                        Background="#0E141B"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" />
                                        <TextBlock Text="OWNED"
                                                   Foreground="#66C0F4"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Margin="10"
                                                   Background="#DD171D25"
                                                   Padding="7,3" />
                                    </Grid>
                                </Button>

                                <StackPanel Grid.Row="1" Margin="12,10,12,12">
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DeveloperPublisherText}" FontSize="11" Margin="0,3,0,4" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding AddedText}" Foreground="#8F98A0" FontSize="11" />

                                    <Border Background="#10151D" BorderBrush="#2A475E" BorderThickness="1" Padding="9" Margin="0,10,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding BuildStatusText}" Foreground="#66C0F4" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding LauncherMessage}" Foreground="#C7D5E0" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="5" Margin="0,7,0,0">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLauncherBusy}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </StackPanel>
                                    </Border>

                                    <WrapPanel>
                                        <Button Content="{Binding PrimaryActionText}"
                                                Command="{Binding DataContext.PrimaryActionCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanPrimaryAction}"
                                                Style="{StaticResource PrimaryButton}"
                                                Padding="13,7"
                                                Margin="0,0,7,0" />

                                        <Button Content="VERIFY FILES"
                                                Command="{Binding DataContext.VerifyCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Padding="11,7"
                                                Margin="0,0,7,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanVerify}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="UNINSTALL"
                                                Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Padding="11,7">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanUninstall}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,14,0,0" />

            <Border Grid.Row="3" Margin="0,24,0,0" Background="#171D25" BorderBrush="#2A475E" BorderThickness="1" Padding="16">
                <TextBlock Text="Launcher v3.4: downloaded archives and installed files use SHA-256 verification. VERIFY FILES checks the local build, REPAIR replaces damaged builds, running games are protected from update/uninstall, and install deletion is restricted to MiniSteam's expected game directories." TextWrapping="Wrap" Foreground="#8F98A0" />
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
