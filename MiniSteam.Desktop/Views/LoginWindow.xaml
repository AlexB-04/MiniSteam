<Window x:Class="MiniSteam.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniSteam Login"
        Width="520"
        Height="610"
        MinWidth="420"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackground}">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.85" RadiusY="0.85">
                <GradientStop Color="#263F55" Offset="0" />
                <GradientStop Color="#10151D" Offset="0.68" />
            </RadialGradientBrush>
        </Grid.Background>

        <Border Width="380"
                Padding="34"
                Background="#E6171D25"
                BorderBrush="#2A475E"
                BorderThickness="1"
                VerticalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,26">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#1A9FFF" Margin="0,0,14,0">
                        <TextBlock Text="M" Foreground="White" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="MINISTEAM" Foreground="White" FontSize="25" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="SIGN IN" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" />
                <TextBlock Text="Welcome back" Foreground="White" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,6" />
                <TextBlock Text="Use the same account as the MiniSteam web store." TextWrapping="Wrap" Margin="0,0,0,24" />

                <TextBlock Text="EMAIL" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"
                         FontSize="14"
                         Margin="0,0,0,16" />

                <TextBlock Text="PASSWORD" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                <PasswordBox x:Name="PasswordInput"
                             KeyDown="PasswordInput_KeyDown"
                             Foreground="White"
                             Background="#0E141B"
                             BorderBrush="#2A475E"
                             BorderThickness="1"
                             Padding="10,8"
                             FontSize="14"
                             Margin="0,0,0,18" />

                <Button Content="Sign in"
                        Click="LoginButton_Click"
                        Style="{StaticResource PrimaryButton}"
                        Height="42" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0" />

                <TextBlock Text="Desktop v3.3 · launcher integrity &amp; Unity delivery"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Margin="0,28,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
