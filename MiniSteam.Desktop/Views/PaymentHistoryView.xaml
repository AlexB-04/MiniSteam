<UserControl x:Class="MiniSteam.Desktop.Views.PaymentHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="COMMERCE" Foreground="#66C0F4" FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="Payments &amp; Receipts" Foreground="White" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,4" />
                    <TextBlock Text="Sandbox payment history, immutable checkout snapshots and full-refund testing." TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" />
            </Grid>

            <WrapPanel Margin="0,0,0,18">
                <Border Background="#171D25" BorderBrush="#2A475E" BorderThickness="1" Padding="16" Margin="0,0,10,10" MinWidth="180">
                    <StackPanel>
                        <TextBlock Text="CAPTURED" Foreground="#66C0F4" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="{Binding CapturedTotalText}" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="#171D25" BorderBrush="#2A475E" BorderThickness="1" Padding="16" Margin="0,0,10,10" MinWidth="180">
                    <StackPanel>
                        <TextBlock Text="REFUNDED" Foreground="#66C0F4" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="{Binding RefundedTotalText}" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="#171D25" BorderBrush="#2A475E" BorderThickness="1" Padding="16" Margin="0,0,10,10" MinWidth="180">
                    <StackPanel>
                        <TextBlock Text="NET SANDBOX" Foreground="#66C0F4" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="{Binding NetTotalText}" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <ItemsControl ItemsSource="{Binding Payments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#171D25" BorderBrush="#2A475E" BorderThickness="1" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Status}" Foreground="#66C0F4" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0">
                                            <Run Text="Payment #" /><Run Text="{Binding Id, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding CreatedText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding TotalText}" Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding ReceiptText}" Foreground="#8F98A0" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="PROVIDER" Foreground="#66C0F4" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Provider}" Foreground="White" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="REFERENCE" Foreground="#66C0F4" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Text="{Binding ProviderReference}" Foreground="#ACB2B8" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,14,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#101820" BorderBrush="#243A4B" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding GameName}" Foreground="White" FontWeight="SemiBold" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding OriginalPriceText}" Foreground="#738895" FontSize="11" Margin="0,0,8,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasDiscountSnapshot}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding DiscountText}" Foreground="#A4D007" FontSize="11">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasDiscountSnapshot}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding PriceText}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock>
                                            <Run Text="Subtotal: " /><Run Text="{Binding SubtotalText, Mode=OneWay}" />
                                            <Run Text="  ·  Tax: " /><Run Text="{Binding TaxAmountText, Mode=OneWay}" />
                                            <Run Text="  ·  Rate: " /><Run Text="{Binding TaxRateText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding FailureReason}" Foreground="#E35D6A" TextWrapping="Wrap" Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding RefundReason}" Foreground="#A4D007" TextWrapping="Wrap" Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding RefundReference}" Foreground="#8F98A0" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="SANDBOX REFUND"
                                            Command="{Binding DataContext.RefundCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"
                                            Margin="14,0,0,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanRefund}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding StatusMessage}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
