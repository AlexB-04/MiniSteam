<UserControl x:Class="MiniSteam.Desktop.Views.StoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,30,28,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MINISTEAM STORE" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="Browse Games" Foreground="White" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,4" />
                    <TextBlock Text="Desktop client connected to the v2.9 API." />
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="#2A475E" BorderThickness="1" Padding="16,10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalItems, StringFormat={}{0} games}" Foreground="White" FontSize="14" />
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,24,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"
                         Height="38"
                         VerticalContentAlignment="Center"
                         ToolTip="Search games" />
                <Button Grid.Column="1" Content="Search" Command="{Binding SearchCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" MinWidth="100" />
            </Grid>

            <WrapPanel Grid.Row="2" Margin="0,0,0,22">
                <Button Content="All" Command="{Binding SectionCommand}" CommandParameter="all" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                <Button Content="Featured" Command="{Binding SectionCommand}" CommandParameter="featured" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                <Button Content="Special Offers" Command="{Binding SectionCommand}" CommandParameter="specials" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                <Button Content="New Releases" Command="{Binding SectionCommand}" CommandParameter="new" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                <Button Content="Early Access" Command="{Binding SectionCommand}" CommandParameter="earlyaccess" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                <Button Content="Free to Play" Command="{Binding SectionCommand}" CommandParameter="free" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                <Button Content="Coming Soon" Command="{Binding SectionCommand}" CommandParameter="comingsoon" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
            </WrapPanel>

            <ItemsControl Grid.Row="3" ItemsSource="{Binding Games}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="262"
                                Height="262"
                                Margin="0,0,14,14"
                                Style="{StaticResource GameCardButton}"
                                Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                CommandParameter="{Binding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="148" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Background="#0E141B">
                                    <TextBlock Text="NO ARTWORK"
                                               Foreground="#66C0F4"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="16" />
                                    <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" />
                                    <Border Background="#4C6B22" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="8,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveDiscountPercent}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding DiscountText}" Foreground="#BEED52" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="12,10">
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DeveloperPublisherText}" FontSize="11" Margin="0,3,0,8" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding GenreName}" FontSize="11" Foreground="#66C0F4" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding OriginalPriceText}" FontSize="11" Foreground="#738895" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveDiscountPercent}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding PriceText}" Foreground="#BEEBFF" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Previous" Command="{Binding PreviousPageCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0" />
                <TextBlock Grid.Column="2" Text="{Binding PageText}" Foreground="White" VerticalAlignment="Center" Margin="10,0" />
                <Button Grid.Column="3" Content="Next" Command="{Binding NextPageCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
