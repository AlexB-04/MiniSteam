@{
    ViewData["Title"] = "Access Denied";
}

<div class="account-page account-state-page">

    <div class="account-state-card account-state-denied">

        <div class="account-state-icon account-state-icon-denied">
            !
        </div>

        <span class="account-state-eyebrow">
            ACCESS RESTRICTED
        </span>

        <h1>Access Denied</h1>

        <p class="account-state-description">
            You do not have permission to access this area of MiniSteam.
        </p>

        <div class="account-state-info">
            <span class="account-state-info-icon">i</span>

            <div>
                <strong>Administrator access required</strong>

                <span>
                    Game and genre management tools are available only to MiniSteam administrators.
                </span>
            </div>
        </div>

        <div class="account-state-actions">
            <a asp-controller="Games"
               asp-action="Store"
               class="account-primary-button account-state-primary">
                Return to Store
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Library"
                   asp-action="Index"
                   class="account-state-secondary">
                    Go to Library
                </a>
            }
        </div>

        <span class="account-state-code">
            ERROR 403
        </span>

    </div>

</div>