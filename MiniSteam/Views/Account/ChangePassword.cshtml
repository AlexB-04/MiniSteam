@model MiniSteam.Models.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="account-page account-security-page">

    <div class="account-heading">

        <span class="account-eyebrow">ACCOUNT SECURITY</span>

        <h1>Change Password</h1>

        <p>Update the password used to sign in to your MiniSteam account.</p>

    </div>


    <div class="account-security-layout">

        <div class="account-card">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="account-success-message">
                    <span>✓</span>
                    <div>@TempData["SuccessMessage"]</div>
                </div>
            }

            <form asp-action="ChangePassword" method="post">

                <div asp-validation-summary="ModelOnly" class="account-validation-summary"></div>

                <div class="account-form-group">
                    <label asp-for="CurrentPassword">Current Password</label>
                    <input asp-for="CurrentPassword" class="account-input" autocomplete="current-password" placeholder="Enter your current password" />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>

                <div class="account-form-divider"></div>

                <div class="account-form-group">
                    <label asp-for="NewPassword">New Password</label>
                    <input asp-for="NewPassword" class="account-input" autocomplete="new-password" placeholder="Enter a new password" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="account-form-group">
                    <label asp-for="ConfirmPassword">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" class="account-input" autocomplete="new-password" placeholder="Repeat your new password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="account-form-actions">
                    <button type="submit" class="account-primary-button account-action-button">Change Password</button>
                    <a asp-controller="Games" asp-action="Store" class="account-cancel-button">Cancel</a>
                </div>

            </form>

        </div>


        <aside class="account-security-info">

            <span class="account-side-eyebrow">SECURITY</span>

            <h2>Protect your account</h2>

            <p>
                A strong password helps prevent unauthorized access to your MiniSteam account.
            </p>

            <div class="account-security-tip">
                <span>01</span>
                <p>Use a unique password.</p>
            </div>

            <div class="account-security-tip">
                <span>02</span>
                <p>Do not share your password.</p>
            </div>

            <div class="account-security-tip">
                <span>03</span>
                <p>Change it if you suspect unauthorized access.</p>
            </div>

        </aside>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}