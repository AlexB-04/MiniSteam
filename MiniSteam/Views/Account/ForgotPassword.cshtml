@model MiniSteam.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="account-page account-recovery-page">

    <div class="account-heading account-heading-centered">
        <span class="account-eyebrow">ACCOUNT RECOVERY</span>
        <h1>Forgot Your Password?</h1>
        <p>Enter the email associated with your MiniSteam account.</p>
    </div>


    <div class="account-recovery-card">

        <div class="account-recovery-icon">?</div>

        <form asp-action="ForgotPassword" method="post">

            <div asp-validation-summary="ModelOnly" class="account-validation-summary"></div>

            <div class="account-form-group">
                <label asp-for="Email">Email Address</label>
                <input asp-for="Email" class="account-input" autocomplete="email" placeholder="Enter your account email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>


            <div class="account-recovery-info">
                If an account exists for that email, MiniSteam will send password reset instructions.
            </div>


            <button type="submit" class="account-primary-button">Send Reset Link</button>


            <a asp-action="Login" class="account-back-link">← Back to Sign In</a>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}