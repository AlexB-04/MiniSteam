@{
    ViewData["Title"] = "Password Reset";
}

<div class="account-page account-recovery-page">

    <div class="account-heading account-heading-centered">

        <span class="account-eyebrow">
            ACCOUNT RECOVERY
        </span>

        <h1>Check Your Email</h1>

        <p>
            Password recovery instructions may be on their way.
        </p>

    </div>


    <div class="account-recovery-card account-state-card">

        <div class="account-state-icon account-state-icon-email">
            ✉
        </div>

        <span class="account-state-eyebrow">
            RESET LINK REQUESTED
        </span>

        <h2>Check your inbox</h2>

        <p class="account-state-description">
            If a MiniSteam account exists for that email address,
            password reset instructions have been sent.
        </p>


        <div class="account-state-info account-state-info-neutral">

            <span class="account-state-info-icon">
                i
            </span>

            <div>
                <strong>Didn't receive an email?</strong>

                <span>
                    Check your spam folder and make sure you entered the correct email address.
                </span>
            </div>

        </div>


        <div class="account-state-actions">

            <a asp-action="Login"
               class="account-primary-button account-state-primary">
                Back to Sign In
            </a>

            <a asp-action="ForgotPassword"
               class="account-state-secondary">
                Try Another Email
            </a>

        </div>

    </div>

</div>