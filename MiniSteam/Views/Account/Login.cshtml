@model MiniSteam.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="account-page">

    <div class="account-heading">
        <span class="account-eyebrow">MINISTEAM ACCOUNT</span>
        <h1>Sign In</h1>
        <p>Access your library, wishlist and purchase history.</p>
    </div>

    <div class="account-login-layout">

        <div class="account-card">

            <form asp-action="Login" method="post">

                <div asp-validation-summary="ModelOnly" class="account-validation-summary"></div>

                <div class="account-form-group">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" class="account-input" autocomplete="email" placeholder="Enter your email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="account-form-group">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" class="account-input" autocomplete="current-password" placeholder="Enter your password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="account-login-options">

                    <label class="account-remember">
                        <input asp-for="RememberMe" />
                        <span>Remember me</span>
                    </label>

                    <a asp-controller="Account" asp-action="ForgotPassword" class="account-help-link">Forgot your password?</a>

                </div>

                <button type="submit" class="account-primary-button">Sign In</button>

            </form>

        </div>


        <aside class="account-side-card">

            <div class="account-side-icon">M</div>

            <span class="account-side-eyebrow">NEW TO MINISTEAM?</span>

            <h2>Create your account</h2>

            <p>
                Build your library, save games to your wishlist and keep your purchase history in one place.
            </p>

            <a asp-action="Register" class="account-secondary-button">Create Account</a>

        </aside>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}