@model MiniSteam.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="account-page">

    <div class="account-heading">
        <span class="account-eyebrow">JOIN MINISTEAM</span>
        <h1>Create Account</h1>
        <p>Create your MiniSteam account and start building your game collection.</p>
    </div>


    <div class="account-login-layout">

        <div class="account-card">

            <form asp-action="Register" method="post">

                <div asp-validation-summary="ModelOnly" class="account-validation-summary"></div>

                <div class="account-form-group">
                    <label asp-for="Email">Email Address</label>
                    <input asp-for="Email" class="account-input" autocomplete="email" placeholder="Enter your email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="account-form-group">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" class="account-input" autocomplete="new-password" placeholder="Create a password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="account-form-group">
                    <label asp-for="ConfirmPassword">Confirm Password</label>
                    <input asp-for="ConfirmPassword" class="account-input" autocomplete="new-password" placeholder="Repeat your password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="account-security-note">
                    <span class="account-security-icon">✓</span>

                    <div>
                        <strong>Keep your account secure</strong>
                        <span>Use a password you do not use on other services.</span>
                    </div>
                </div>

                <button type="submit" class="account-primary-button">Create Account</button>

            </form>

        </div>


        <aside class="account-side-card">

            <div class="account-side-icon account-side-icon-secondary">✓</div>

            <span class="account-side-eyebrow">ALREADY REGISTERED?</span>

            <h2>Welcome back</h2>

            <p>
                Sign in to access your existing library, wishlist and purchases.
            </p>

            <a asp-action="Login" class="account-secondary-button">Sign In</a>

        </aside>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}