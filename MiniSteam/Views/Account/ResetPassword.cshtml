@model MiniSteam.Models.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="account-page account-recovery-page">

    <div class="account-heading account-heading-centered">

        <span class="account-eyebrow">ACCOUNT RECOVERY</span>

        <h1>Create New Password</h1>

        <p>Choose a new password for your MiniSteam account.</p>

    </div>


    <div class="account-recovery-card">

        <div class="account-recovery-icon account-recovery-success-icon">✓</div>


        <form asp-action="ResetPassword" method="post">

            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />


            <div asp-validation-summary="ModelOnly" class="account-validation-summary"></div>


            <div class="account-form-group">

                <label asp-for="NewPassword">New Password</label>

                <input asp-for="NewPassword" class="account-input" autocomplete="new-password" placeholder="Enter a new password" />

                <span asp-validation-for="NewPassword" class="text-danger"></span>

            </div>


            <div class="account-form-group">

                <label asp-for="ConfirmPassword">Confirm Password</label>

                <input asp-for="ConfirmPassword" class="account-input" autocomplete="new-password" placeholder="Repeat your new password" />

                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

            </div>


            <div class="account-security-note">

                <span class="account-security-icon">✓</span>

                <div>
                    <strong>Choose a new password</strong>
                    <span>Do not reuse the password that you are replacing.</span>
                </div>

            </div>


            <button type="submit" class="account-primary-button">Reset Password</button>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}