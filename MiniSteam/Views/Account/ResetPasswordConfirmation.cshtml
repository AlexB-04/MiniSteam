@{
    ViewData["Title"] = "Password Changed";
}

<div class="account-page account-recovery-page">

    <div class="account-heading account-heading-centered">

        <span class="account-eyebrow">
            ACCOUNT SECURITY
        </span>

        <h1>Password Changed</h1>

        <p>
            Your MiniSteam account password has been updated.
        </p>

    </div>


    <div class="account-recovery-card account-state-card">

        <div class="account-state-icon account-state-icon-success">
            ✓
        </div>

        <span class="account-state-eyebrow account-state-eyebrow-success">
            PASSWORD UPDATED
        </span>

        <h2>You're all set</h2>

        <p class="account-state-description">
            Your password has been reset successfully.
            You can now sign in using your new password.
        </p>


        <div class="account-state-info account-state-info-success">

            <span class="account-state-info-icon">
                ✓
            </span>

            <div>
                <strong>Your new password is active</strong>

                <span>
                    Use it the next time you sign in to MiniSteam.
                </span>
            </div>

        </div>


        <a asp-action="Login"
           class="account-primary-button account-state-primary">
            Sign In to MiniSteam
        </a>

    </div>

</div>