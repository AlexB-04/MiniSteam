@model MiniSteam.Models.ViewModels.GameViewModel
@using MiniSteam.Models.Entities

@{
    ViewData["Title"] = "Create Game";
}

<div class="admin-game-form-page">

    <div class="admin-form-navigation">
        <a asp-action="Index">← Back to Game Management</a>
        <span>STORE ADMIN</span>
    </div>


    <div class="admin-form-heading">

        <span class="admin-page-eyebrow">NEW APPLICATION</span>

        <h1>Create Game</h1>

        <p>Add a new game to the MiniSteam catalog.</p>

    </div>


    <form asp-action="Create" method="post" enctype="multipart/form-data" class="admin-game-form">

        <div asp-validation-summary="ModelOnly" class="admin-form-validation"></div>


        <div class="admin-form-layout">

            <div class="admin-form-main">

                <section class="admin-form-section">

                    <div class="admin-form-section-heading">

                        <span class="admin-form-section-number">01</span>

                        <div>
                            <h2>Store Information</h2>
                            <p>Basic information shown on the game store page.</p>
                        </div>

                    </div>


                    <div class="admin-field">

                        <label asp-for="Name">Game Name</label>

                        <input asp-for="Name" class="admin-form-input" placeholder="Enter game name" />

                        <span asp-validation-for="Name" class="text-danger"></span>

                    </div>


                    <div class="admin-field">

                        <label asp-for="Description">Description</label>

                        <textarea asp-for="Description" class="admin-form-input admin-form-textarea" rows="7" placeholder="Describe the game"></textarea>

                        <span asp-validation-for="Description" class="text-danger"></span>

                        <small>Used on the MiniSteam store page.</small>

                    </div>


                    <div class="admin-field-grid">

                        <div class="admin-field">

                            <label asp-for="Developer">Developer</label>

                            <input asp-for="Developer" class="admin-form-input" placeholder="Developer name" />

                            <span asp-validation-for="Developer" class="text-danger"></span>

                        </div>


                        <div class="admin-field">

                            <label asp-for="Publisher">Publisher</label>

                            <input asp-for="Publisher" class="admin-form-input" placeholder="Publisher name" />

                            <span asp-validation-for="Publisher" class="text-danger"></span>

                        </div>

                    </div>


                    <div class="admin-field-grid">

                        <div class="admin-field">

                            <label asp-for="ReleaseDate">Release Date</label>

                            <input asp-for="ReleaseDate" class="admin-form-input" />

                            <span asp-validation-for="ReleaseDate" class="text-danger"></span>

                        </div>


                        <div class="admin-field">

                            <label asp-for="Price">Price</label>

                            <div class="admin-price-input">
                                <input asp-for="Price" class="admin-form-input" />
                                <span>€</span>
                            </div>

                            <span asp-validation-for="Price" class="text-danger"></span>

                            <small>Use 0 for a free game.</small>

                        </div>

                    </div>


                    <div class="admin-field">
                        <label asp-for="DiscountPercent">Discount</label>

                        <div class="admin-price-input">
                            <input asp-for="DiscountPercent" class="admin-form-input" min="0" max="95" />
                            <span>%</span>
                        </div>

                        <span asp-validation-for="DiscountPercent" class="text-danger"></span>
                        <small>Use 0 for no discount. Free games ignore discounts.</small>
                    </div>

                    <div class="admin-field-grid">

                        <div class="admin-field">
                            <label asp-for="DiscountStartDate">Discount Start</label>
                            <input asp-for="DiscountStartDate" class="admin-form-input" />
                            <span asp-validation-for="DiscountStartDate" class="text-danger"></span>
                            <small>Optional. Leave empty for an immediate discount.</small>
                        </div>

                        <div class="admin-field">
                            <label asp-for="DiscountEndDate">Discount End</label>
                            <input asp-for="DiscountEndDate" class="admin-form-input" />
                            <span asp-validation-for="DiscountEndDate" class="text-danger"></span>
                            <small>Optional. Leave empty for no automatic end date.</small>
                        </div>

                    </div>

                    <div class="admin-field">
                        <label asp-for="ReleaseStatus">Release Status</label>
                        <select asp-for="ReleaseStatus"
                                class="admin-form-input admin-form-select"
                                asp-items="Html.GetEnumSelectList<GameReleaseStatus>()">
                        </select>
                        <span asp-validation-for="ReleaseStatus" class="text-danger"></span>
                        <small>Coming Soon games can be wishlisted but cannot be purchased yet.</small>
                    </div>

                </section>


                <section class="admin-form-section admin-store-experience-section">
                    <div class="admin-form-section-heading">
                        <span class="admin-form-section-number">03</span>

                        <div>
                            <h2>Store Experience</h2>
                            <p>Tags, screenshots, trailer and richer information for the game page.</p>
                        </div>
                    </div>

                    <div class="admin-field">
                        <label asp-for="TagsText">Tags</label>
                        <input asp-for="TagsText" class="admin-form-input" placeholder="Indie, Adventure, Atmospheric" />
                        <span asp-validation-for="TagsText" class="text-danger"></span>
                        <small>Separate tags with commas. Maximum 20 tags.</small>
                    </div>

                    <div class="admin-field">
                        <label asp-for="ScreenshotUrlsText">Screenshot URLs</label>
                        <textarea asp-for="ScreenshotUrlsText" class="admin-form-input admin-form-textarea" rows="6" placeholder="https://example.com/screenshot-1.jpg&#10;https://example.com/screenshot-2.jpg"></textarea>
                        <span asp-validation-for="ScreenshotUrlsText" class="text-danger"></span>
                        <small>One URL per line. HTTP/HTTPS or a local /images/... path. Maximum 12.</small>
                    </div>

                    <div class="admin-field">
                        <label asp-for="TrailerUrl">Trailer URL</label>
                        <input asp-for="TrailerUrl" class="admin-form-input" placeholder="https://www.youtube.com/watch?v=..." />
                        <span asp-validation-for="TrailerUrl" class="text-danger"></span>
                        <small>YouTube watch/youtu.be/embed links or a direct MP4/WEBM URL.</small>
                    </div>
                </section>


                <section class="admin-form-section admin-system-requirements-section">
                    <div class="admin-form-section-heading">
                        <span class="admin-form-section-number">04</span>

                        <div>
                            <h2>System Requirements</h2>
                            <p>Optional PC requirements shown on the store page.</p>
                        </div>
                    </div>

                    <div class="admin-field-grid">
                        <div class="admin-field">
                            <label asp-for="MinimumSystemRequirements">Minimum</label>
                            <textarea asp-for="MinimumSystemRequirements" class="admin-form-input admin-form-textarea" rows="8" placeholder="OS: Windows 10&#10;Processor: ...&#10;Memory: ..."></textarea>
                            <span asp-validation-for="MinimumSystemRequirements" class="text-danger"></span>
                        </div>

                        <div class="admin-field">
                            <label asp-for="RecommendedSystemRequirements">Recommended</label>
                            <textarea asp-for="RecommendedSystemRequirements" class="admin-form-input admin-form-textarea" rows="8" placeholder="OS: Windows 11&#10;Processor: ...&#10;Memory: ..."></textarea>
                            <span asp-validation-for="RecommendedSystemRequirements" class="text-danger"></span>
                        </div>
                    </div>
                </section>

            </div>


            <aside class="admin-form-sidebar">

                <section class="admin-form-side-card">

                    <div class="admin-side-heading">

                        <span class="admin-form-section-number">02</span>

                        <div>
                            <h2>Store Presence</h2>
                            <p>Control how the game appears in MiniSteam.</p>
                        </div>

                    </div>


                    <div class="admin-field">

                        <label asp-for="GenreId">Genre</label>

                        <select asp-for="GenreId" class="admin-form-input admin-form-select" asp-items="ViewBag.GenreId"><option value="">Select Genre</option></select>

                        <span asp-validation-for="GenreId" class="text-danger"></span>

                    </div>


                    <div class="admin-field">

                        <label asp-for="ImageFile">Store Artwork</label>

                        <input asp-for="ImageFile" type="file" class="admin-file-input" accept=".jpg,.jpeg,.png,.webp" />

                        <span asp-validation-for="ImageFile" class="text-danger"></span>

                        <div class="admin-upload-note">
                            <span>IMAGE</span>
                            <p>JPG, JPEG, PNG or WEBP. Maximum size 5 MB.</p>
                        </div>

                    </div>


                    <div class="admin-publish-option">

                        <div>
                            <strong>Featured Game</strong>
                            <span>Allow this game to appear in the Featured discovery shelf.</span>
                        </div>

                        <label class="admin-switch">
                            <input asp-for="IsFeatured" />
                            <span class="admin-switch-slider"></span>
                        </label>

                    </div>


                    <div class="admin-publish-option">

                        <div>
                            <strong>Public Store Page</strong>
                            <span>Show this game to users in the MiniSteam Store.</span>
                        </div>

                        <label class="admin-switch">
                            <input asp-for="IsPublic" />
                            <span class="admin-switch-slider"></span>
                        </label>

                    </div>

                </section>


                <div class="admin-form-help">

                    <span>STORE ADMIN</span>

                    <p>
                        You can edit the game later from Game Management.
                    </p>

                </div>

            </aside>

        </div>


        <div class="admin-form-footer">

            <a asp-action="Index" class="admin-form-cancel">Cancel</a>

            <button type="submit" class="admin-form-save">
                Create Game
            </button>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}