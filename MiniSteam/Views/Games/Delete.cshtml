@model MiniSteam.Models.Entities.Game

@{
    ViewData["Title"] = "Delete Game";
}

<div class="admin-delete-page">

    <div class="admin-form-navigation">
        <a asp-action="Index">← Back to Game Management</a>
        <span>GAME ID @Model.Id</span>
    </div>


    <div class="admin-delete-card">

        <div class="admin-delete-warning-icon">!</div>

        <span class="admin-delete-eyebrow">
            DESTRUCTIVE ACTION
        </span>

        <h1>Delete Game?</h1>

        <p class="admin-delete-description">
            This will permanently remove this game from MiniSteam if it is not referenced by purchase history.
        </p>


        <div class="admin-delete-game">

            <div class="admin-delete-image">

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" />
                }
                else
                {
                    <img src="/images/noimage.jpg" alt="No image available" />
                }

            </div>


            <div class="admin-delete-game-info">

                <span class="admin-app-id">
                    GAME ID @Model.Id
                </span>

                <h2>@Model.Name</h2>

                <span>@Model.Developer</span>

                <div class="admin-delete-meta">

                    <div>
                        <small>PRICE</small>

                        @if (Model.Price == 0)
                        {
                            <strong class="admin-free-price">Free</strong>
                        }
                        else
                        {
                            <strong>@Model.Price.ToString("0.00") €</strong>
                        }
                    </div>

                    <div>
                        <small>RELEASE DATE</small>
                        <strong>@Model.ReleaseDate.ToString("dd MMM yyyy")</strong>
                    </div>

                    <div>
                        <small>STATUS</small>

                        @if (Model.IsPublic)
                        {
                            <strong class="admin-delete-public">Public</strong>
                        }
                        else
                        {
                            <strong>Hidden</strong>
                        }

                    </div>

                </div>

            </div>

        </div>


        <div class="admin-delete-warning">

            <span class="admin-delete-warning-small">!</span>

            <div>
                <strong>This action cannot be undone</strong>

                <span>
                    Purchase history may prevent deletion if this game has already been purchased.
                </span>
            </div>

        </div>


        <form asp-action="Delete" method="post" class="admin-delete-actions">

            <input type="hidden" asp-for="Id" />

            <a asp-action="Index" class="admin-delete-cancel">
                Cancel
            </a>

            <button type="submit" class="admin-delete-confirm">
                Delete Game
            </button>

        </form>

    </div>

</div>