@model MiniSteam.Models.Entities.Game
@using MiniSteam.Models.Entities

@{
    ViewData["Title"] = Model.Name;

    var reviews = ViewBag.Reviews as IEnumerable<MiniSteam.Models.Entities.Review>
        ?? Enumerable.Empty<MiniSteam.Models.Entities.Review>();

    var reviewList = reviews.ToList();
    var reviewCount = reviewList.Count;
    var recommendedCount = reviewList.Count(review => review.IsRecommended);

    var recommendedPercent = reviewCount == 0
        ? 0
        : (int)Math.Round((double)recommendedCount / reviewCount * 100);

    var reviewScoreLabel = MiniSteam.Helpers.ReviewScoreHelper.GetLabel(
        reviewCount,
        recommendedPercent);

    var isFree = Model.Price == 0;
    var isComingSoon = Model.ReleaseStatus == GameReleaseStatus.ComingSoon;
    var isEarlyAccess = Model.ReleaseStatus == GameReleaseStatus.EarlyAccess;

    var screenshots = Model.Screenshots
        .OrderBy(screenshot => screenshot.SortOrder)
        .ToList();

    var tags = Model.Tags
        .OrderBy(tag => tag.Name)
        .ToList();

    var fallbackMediaUrl = Model.ImageUrl ?? "/images/noimage.jpg";
    var mainMediaUrl = screenshots.FirstOrDefault()?.Url ?? fallbackMediaUrl;

    var trailerUrl = Model.TrailerUrl?.Trim();
    string? trailerEmbedUrl = null;
    string? trailerPreviewUrl = null;
    var trailerIsYouTube = false;

    if (!string.IsNullOrWhiteSpace(trailerUrl) && Uri.TryCreate(trailerUrl, UriKind.Absolute, out var trailerUri))
    {
        var host = trailerUri.Host.ToLowerInvariant();
        string? youtubeId = null;

        if (host == "youtu.be" || host.EndsWith(".youtu.be"))
        {
            youtubeId = trailerUri.AbsolutePath.Trim('/').Split('/').FirstOrDefault();
        }
        else if (host.Contains("youtube.com"))
        {
            var segments = trailerUri.AbsolutePath.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries);

            if (segments.Length >= 2 && (segments[0] == "embed" || segments[0] == "shorts"))
            {
                youtubeId = segments[1];
            }
            else
            {
                var queryParts = trailerUri.Query.TrimStart('?')
                    .Split('&', StringSplitOptions.RemoveEmptyEntries);

                foreach (var queryPart in queryParts)
                {
                    var pair = queryPart.Split('=', 2);
                    if (pair.Length == 2 && pair[0] == "v")
                    {
                        youtubeId = Uri.UnescapeDataString(pair[1]);
                        break;
                    }
                }
            }
        }

        if (!string.IsNullOrWhiteSpace(youtubeId))
        {
            trailerIsYouTube = true;
            trailerEmbedUrl = $"https://www.youtube.com/embed/{youtubeId}?rel=0";
            trailerPreviewUrl = $"https://img.youtube.com/vi/{youtubeId}/hqdefault.jpg";
        }
        else
        {
            trailerEmbedUrl = trailerUrl;
        }
    }

    var hasTrailer = !string.IsNullOrWhiteSpace(trailerEmbedUrl);
    var galleryHasMedia = screenshots.Any() || hasTrailer;
    var initialMediaIndex = hasTrailer && screenshots.Any() ? 1 : 0;
}
<div class="game-details-page game-details-v2">

    @if (TempData["CartMessage"] != null)
    {
        <div class="game-action-notice">
            @TempData["CartMessage"]
        </div>
    }

    @if (TempData["WishlistMessage"] != null)
    {
        <div class="game-action-notice">
            @TempData["WishlistMessage"]
        </div>
    }

    @if (TempData["ReviewMessage"] != null)
    {
        <div class="game-action-notice">
            @TempData["ReviewMessage"]
        </div>
    }


    <div class="game-details-navigation">
        @if (ViewBag.From == "games")
        {
            <a asp-action="Index" class="game-details-back">← Back to Games</a>
        }
        else if (ViewBag.From == "library")
        {
            <a asp-controller="Library" asp-action="Index" class="game-details-back">← Back to Library</a>
        }
        else if (ViewBag.From == "wishlist")
        {
            <a asp-controller="Wishlist" asp-action="Index" class="game-details-back">← Back to Wishlist</a>
        }
        else if (ViewBag.From == "cart")
        {
            <a asp-controller="Cart" asp-action="Index" class="game-details-back">← Back to Cart</a>
        }
        else
        {
            <a asp-action="Store" class="game-details-back">← Back to Store</a>
        }

        <span class="game-details-store-label">MINISTEAM STORE</span>
    </div>

    <div class="game-details-heading">
        <div>
            <h1 class="game-details-title">@Model.Name</h1>

            <div class="game-details-heading-badges">
                @if (Model.Genre != null)
                {
                    <a asp-action="Store"
                       asp-route-genreId="@Model.GenreId"
                       class="game-details-genre-pill game-details-filter-link"
                       title="Browse @Model.Genre.Name games">@Model.Genre.Name</a>
                }

                @if (isComingSoon)
                {
                    <span class="game-release-badge game-release-coming">COMING SOON</span>
                }
                else if (isEarlyAccess)
                {
                    <span class="game-release-badge game-release-early">EARLY ACCESS</span>
                }

                @if (Model.IsFeatured)
                {
                    <span class="game-release-badge game-release-featured">FEATURED</span>
                }
            </div>
        </div>

        @if (ViewBag.IsInLibrary == true)
        {
            <div class="game-owned-badge">
                <span class="game-owned-check">✓</span>
                <span>IN YOUR LIBRARY</span>
            </div>
        }
    </div>

    <div class="game-details-main game-details-hero">

        <div class="game-media-column">
            <div id="gameMediaGallery"
                 class="game-media-gallery"
                 data-initial-index="@initialMediaIndex"
                 tabindex="0"
                 aria-label="Media gallery for @Model.Name">

                <div class="game-details-image game-feature-media @(screenshots.Any() ? "has-screenshots" : "cover-fallback")">
                    <button type="button" class="game-media-nav game-media-nav-prev" data-media-prev aria-label="Previous media">‹</button>

                    <div id="gameMediaStage" class="game-media-stage">
                        <img id="gameMainMediaImage" src="@mainMediaUrl" alt="@Model.Name screenshot" />
                        <iframe id="gameMainMediaFrame"
                                class="game-media-frame"
                                title="@Model.Name trailer"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen
                                hidden></iframe>
                        <video id="gameMainMediaVideo" class="game-media-video" controls playsinline hidden></video>
                    </div>

                    <button type="button"
                            id="gameMediaExpand"
                            class="game-media-expand"
                            title="View image fullscreen"
                            aria-label="View image fullscreen">⛶</button>

                    <button type="button" class="game-media-nav game-media-nav-next" data-media-next aria-label="Next media">›</button>
                </div>

                @if (galleryHasMedia)
                {
                    <div class="game-media-thumbnails" aria-label="Game media">

                        @if (hasTrailer)
                        {
                            <button type="button"
                                    class="game-media-thumbnail"
                                    data-media-index="0"
                                    data-media-type="@(trailerIsYouTube ? "youtube" : "video")"
                                    data-media-url="@trailerEmbedUrl"
                                    title="Play trailer">

                                @if (!string.IsNullOrWhiteSpace(trailerPreviewUrl))
                                {
                                    <img src="@trailerPreviewUrl" alt="@Model.Name trailer preview" />
                                    <span class="game-media-play-icon">▶</span>
                                }

                                <span class="game-media-type-label">TRAILER</span>
                            </button>
                        }

                        @for (var i = 0; i < screenshots.Count; i++)
                        {
                            var screenshot = screenshots[i];
                            var screenshotMediaIndex = i + (hasTrailer ? 1 : 0);

                            <button type="button"
                                    class="game-media-thumbnail"
                                    data-media-index="@screenshotMediaIndex"
                                    data-media-type="image"
                                    data-media-url="@screenshot.Url"
                                    title="View screenshot">
                                <img src="@screenshot.Url" alt="@Model.Name screenshot" />
                            </button>
                        }

                    </div>

                    <div class="game-media-hint">
                        <span>Click an image to enlarge</span>
                        <span>Use ← → after focusing the gallery</span>
                    </div>
                }
            </div>
        </div>

        <div class="game-details-info">

            <div class="game-details-summary">

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p>@Model.Description</p>
                }
                else
                {
                    <p>No description is currently available for this game.</p>
                }

            </div>

            <div class="game-details-meta">

                <div class="game-details-property">
                    <span class="game-details-label">Reviews</span>

                    @if (reviewCount > 0)
                    {
                        <span class="game-details-review-value">@reviewScoreLabel</span>
                        <span class="game-details-review-count">(@reviewCount · @recommendedPercent%)</span>
                    }
                    else
                    {
                        <span class="game-details-muted">No reviews yet</span>
                    }
                </div>

                <div class="game-details-property">
                    <span class="game-details-label">Release Date</span>
                    <span>
                        @if (isComingSoon)
                        {
                            <text>Coming @Model.ReleaseDate.ToString("dd MMM yyyy")</text>
                        }
                        else
                        {
                            <text>@Model.ReleaseDate.ToString("dd MMM yyyy")</text>
                        }
                    </span>
                </div>

                <div class="game-details-property">
                    <span class="game-details-label">Status</span>
                    <span>
                        @(isComingSoon ? "Coming Soon" :
                          isEarlyAccess ? "Early Access" :
                          "Released")
                    </span>
                </div>

                <div class="game-details-property">
                    <span class="game-details-label">Developer</span>
                    <a asp-action="Store"
                       asp-route-developer="@Model.Developer"
                       class="game-details-link-value"
                       title="Browse games by @Model.Developer">@Model.Developer</a>
                </div>

                <div class="game-details-property">
                    <span class="game-details-label">Publisher</span>
                    @if (!string.IsNullOrWhiteSpace(Model.Publisher))
                    {
                        <a asp-action="Store"
                           asp-route-publisher="@Model.Publisher"
                           class="game-details-link-value"
                           title="Browse games published by @Model.Publisher">@Model.Publisher</a>
                    }
                    else
                    {
                        <span>Unknown</span>
                    }
                </div>

                <div class="game-details-property">
                    <span class="game-details-label">Genre</span>
                    @if (Model.Genre != null)
                    {
                        <a asp-action="Store"
                           asp-route-genreId="@Model.GenreId"
                           class="game-details-inline-filter"
                           title="Browse @Model.Genre.Name games">@Model.Genre.Name</a>
                    }
                    else
                    {
                        <span>Unknown</span>
                    }
                </div>

            </div>

            @if (tags.Any())
            {
                <div class="game-tag-list">
                    @foreach (var tag in tags)
                    {
                        <a asp-action="Store"
                           asp-route-tag="@tag.Name"
                           class="game-tag-pill"
                           title="Browse games tagged @tag.Name">@tag.Name</a>
                    }
                </div>
            }

            <div class="game-purchase-panel">

                <div class="game-purchase-top">
                    <div>
                        <span class="game-purchase-caption">
                            @if (ViewBag.IsInLibrary == true)
                            {
                                <text>You own this game</text>
                            }
                            else if (isComingSoon)
                            {
                                <text>@Model.Name is coming soon</text>
                            }
                            else if (isFree)
                            {
                                <text>Play @Model.Name</text>
                            }
                            else
                            {
                                <text>Buy @Model.Name</text>
                            }
                        </span>

                        @if (Model.HasDiscount && Model.DiscountEndDate.HasValue)
                        {
                            <small class="game-offer-deadline">
                                Offer ends @Model.DiscountEndDate.Value.ToString("dd MMM yyyy")
                            </small>
                        }
                    </div>

                    <div class="game-purchase-price">
                        @if (isComingSoon)
                        {
                            <span class="game-coming-price">Available @Model.ReleaseDate.ToString("dd MMM yyyy")</span>
                        }
                        else if (isFree)
                        {
                            <span class="game-purchase-free">Free</span>
                        }
                        else if (Model.HasDiscount)
                        {
                            <div class="game-discount-price">
                                <span class="game-discount-badge">-@Model.ActiveDiscountPercent%</span>
                                <span class="game-original-price">@Model.Price.ToString("0.00") €</span>
                                <span class="game-final-price">@Model.FinalPrice.ToString("0.00") €</span>
                            </div>
                        }
                        else
                        {
                            <span>@Model.FinalPrice.ToString("0.00") €</span>
                        }
                    </div>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="game-purchase-actions">

                        @if (ViewBag.IsInLibrary == true)
                        {
                            <button type="button" class="game-owned-button" disabled>In Library</button>
                        }
                        else
                        {
                            @if (!isComingSoon)
                            {
                                @if (isFree)
                                {
                                    <form asp-controller="Purchase" asp-action="Buy" asp-route-gameId="@Model.Id" method="post">
                                        <button type="submit" class="game-buy-button">Get Game</button>
                                    </form>
                                }
                                else if (ViewBag.IsInCart == true)
                                {
                                    <a asp-controller="Cart" asp-action="Index" class="game-buy-button game-cart-view-button">View Cart</a>
                                }
                                else
                                {
                                    <form asp-controller="Cart"
                                          asp-action="Add"
                                          asp-route-gameId="@Model.Id"
                                          asp-route-returnUrl="@Url.Action("Details", "Games", new { id = Model.Id })"
                                          method="post">
                                        <button type="submit" class="game-buy-button">Add to Cart</button>
                                    </form>
                                }
                            }

                            @if (ViewBag.IsInWishlist == true)
                            {
                                <button type="button" class="game-wishlist-button game-wishlist-added" disabled>✓ In Wishlist</button>
                            }
                            else
                            {
                                <form asp-controller="Wishlist" asp-action="AddToWishlist" asp-route-gameId="@Model.Id" method="post">
                                    <button type="submit" class="game-wishlist-button">
                                        Add to Wishlist
                                    </button>
                                </form>
                            }
                        }

                    </div>
                }
                else
                {
                    <div class="game-purchase-login">
                        <a asp-controller="Account" asp-action="Login">Sign in</a>
                        <span>
                            @(isComingSoon
                                ? "to add this game to your wishlist."
                                : "to purchase this game or add it to your wishlist.")
                        </span>
                    </div>
                }

            </div>

        </div>

    </div>


    <section class="game-about-section">

        <div class="game-section-heading">
            <div>
                <span class="game-section-eyebrow">ABOUT</span>
                <h2>About This Game</h2>
            </div>
        </div>

        <div class="game-about-content">
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p>@Model.Description</p>
            }
            else
            {
                <p>No description available.</p>
            }
        </div>

    </section>


    @if (!string.IsNullOrWhiteSpace(Model.MinimumSystemRequirements) ||
         !string.IsNullOrWhiteSpace(Model.RecommendedSystemRequirements))
    {
        <section class="game-system-section">
            <div class="game-section-heading">
                <div>
                    <span class="game-section-eyebrow">PC</span>
                    <h2>System Requirements</h2>
                </div>
            </div>

            <div class="game-system-grid">
                <div class="game-system-card">
                    <span>MINIMUM</span>
                    <p>@(Model.MinimumSystemRequirements ?? "Not specified.")</p>
                </div>

                <div class="game-system-card">
                    <span>RECOMMENDED</span>
                    <p>@(Model.RecommendedSystemRequirements ?? "Not specified.")</p>
                </div>
            </div>
        </section>
    }


    <section class="game-reviews game-reviews-v2">

        <div class="game-section-heading game-review-section-heading">

            <div>
                <span class="game-section-eyebrow">COMMUNITY</span>
                <h2>User Reviews</h2>
            </div>

            @if (ViewBag.CanReview == true)
            {
                <a asp-controller="Review" asp-action="Create" asp-route-gameId="@Model.Id" class="game-write-review-button">Write a Review</a>
            }

        </div>


        <div class="game-review-summary">

            <div class="game-review-summary-main">

                @if (reviewCount == 0)
                {
                    <span class="game-review-summary-title game-review-summary-empty">No Reviews</span>
                    <span class="game-review-summary-description">This game has not received any user reviews yet.</span>
                }
                else
                {
                    <span class="game-review-summary-title">@reviewScoreLabel</span>
                    <span class="game-review-summary-description">@recommendedPercent% positive · @recommendedCount of @reviewCount users recommend this game.</span>
                }

            </div>

            <div class="game-review-summary-count">
                <strong>@reviewCount</strong>
                <span>@(reviewCount == 1 ? "review" : "reviews")</span>
            </div>

        </div>


        @if (!reviewList.Any())
        {
            <div class="game-reviews-empty game-reviews-empty-v2">
                <div class="game-reviews-empty-icon">✎</div>
                <h3>No reviews yet</h3>
                <p>Owners of this game can share whether they recommend it.</p>
            </div>
        }
        else
        {
            <div class="game-review-list">

                @foreach (var review in reviewList)
                {
                    var helpfulCount = review.Votes.Count(vote => vote.IsHelpful);
                    var notHelpfulCount = review.Votes.Count(vote => !vote.IsHelpful);
                    var currentUserId = ViewBag.CurrentUserId as string;
                    var currentVote = currentUserId == null
                        ? null
                        : review.Votes.FirstOrDefault(vote => vote.UserId == currentUserId);

                    <article class="review-card review-card-v2">

                        <div class="review-card-side">

                            <div class="review-avatar">
                                @if (ViewBag.CurrentUserId != null && review.UserId == ViewBag.CurrentUserId)
                                {
                                    <span>Y</span>
                                }
                                else
                                {
                                    <span>M</span>
                                }
                            </div>

                            @if (ViewBag.CurrentUserId != null && review.UserId == ViewBag.CurrentUserId)
                            {
                                <span class="review-user review-user-v2">You</span>
                            }
                            else
                            {
                                <span class="review-user review-user-v2">MiniSteam User</span>
                            }

                        </div>

                        <div class="review-card-body">

                            <div class="review-card-header review-card-header-v2">

                                @if (review.IsRecommended)
                                {
                                    <div class="review-verdict review-verdict-positive">
                                        <span class="review-verdict-icon">✓</span>

                                        <div>
                                            <strong>Recommended</strong>
                                            <span>Recommended this game</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="review-verdict review-verdict-negative">
                                        <span class="review-verdict-icon">×</span>

                                        <div>
                                            <strong>Not Recommended</strong>
                                            <span>Does not recommend this game</span>
                                        </div>
                                    </div>
                                }

                            </div>

                            <p class="review-content">@review.Content</p>

                            <div class="review-helpful-row">
                                <div>
                                    <span class="review-helpful-label">Was this review helpful?</span>
                                    <span class="review-helpful-count">
                                        @helpfulCount helpful · @notHelpfulCount not helpful
                                    </span>
                                </div>

                                @if (User.Identity?.IsAuthenticated == true &&
                                     currentUserId != review.UserId)
                                {
                                    <div class="review-vote-actions">
                                        <form asp-controller="Review"
                                              asp-action="Vote"
                                              asp-route-id="@review.Id"
                                              asp-route-gameId="@Model.Id"
                                              asp-route-isHelpful="true"
                                              method="post">
                                            <button type="submit"
                                                    class="review-vote-button @(currentVote?.IsHelpful == true ? "selected" : "")">
                                                Yes @helpfulCount
                                            </button>
                                        </form>

                                        <form asp-controller="Review"
                                              asp-action="Vote"
                                              asp-route-id="@review.Id"
                                              asp-route-gameId="@Model.Id"
                                              asp-route-isHelpful="false"
                                              method="post">
                                            <button type="submit"
                                                    class="review-vote-button @(currentVote?.IsHelpful == false ? "selected" : "")">
                                                No @notHelpfulCount
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>

                            <div class="review-footer">

                                <div class="review-date">
                                    Posted @review.CreatedAt.ToString("dd MMM yyyy")

                                    @if (review.UpdatedAt != null)
                                    {
                                        <span> · Edited @review.UpdatedAt.Value.ToString("dd MMM yyyy")</span>
                                    }
                                </div>

                                @if (ViewBag.CurrentUserId != null && review.UserId == ViewBag.CurrentUserId)
                                {
                                    <div class="review-actions">
                                        <a asp-controller="Review" asp-action="Edit" asp-route-id="@review.Id" class="review-edit-button">Edit</a>
                                        <a asp-controller="Review" asp-action="Delete" asp-route-id="@review.Id" class="review-delete-button">Delete</a>
                                    </div>
                                }

                            </div>

                        </div>

                    </article>
                }

            </div>
        }

    </section>

</div>


<div id="gameMediaLightbox" class="game-media-lightbox" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Game media viewer">
    <button type="button" class="game-media-lightbox-close" data-lightbox-close aria-label="Close media viewer">×</button>
    <button type="button" class="game-media-lightbox-nav game-media-lightbox-prev" data-lightbox-prev aria-label="Previous media">‹</button>

    <div class="game-media-lightbox-stage">
        <img id="gameLightboxImage" alt="@Model.Name screenshot" hidden />
        <iframe id="gameLightboxFrame"
                title="@Model.Name trailer"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                hidden></iframe>
        <video id="gameLightboxVideo" controls playsinline hidden></video>
    </div>

    <button type="button" class="game-media-lightbox-nav game-media-lightbox-next" data-lightbox-next aria-label="Next media">›</button>
    <div class="game-media-lightbox-help">← → navigate · Esc close</div>
</div>

@section Scripts {
    <script src="~/js/game-media.js" asp-append-version="true"></script>
}
