@model IEnumerable<MiniSteam.Models.Entities.Game>

@{
    ViewData["Title"] = "Games";
}

<h1>Games</h1>

<p>
    <a asp-action="Create" class="btn btn-success">
        Create New
    </a>
</p>

<div class="steam-search-bar">
    <form asp-action="Search" method="get" class="steam-search-form">

        <select name="genreId" class="steam-genre-select" asp-items="ViewBag.GenreId"> <option value="">All Genres</option></select>

        <div class="steam-search-box"> <input type="text" name="searchString" value="@Context.Request.Query["searchString"]" placeholder="search the store" />
            <button type="submit" title="Search">🔍</button>
        </div>

        <a asp-action="Index" class="steam-clear"> Clear </a>

    </form>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Developer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Publisher)
            </th>
            <th>
                Genre
            </th>
            <th>
                Image
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsPublic)
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Description)
            </td>
            <td>
                @Html.DisplayFor(model => item.Price)
            </td>
            <td>
                @Html.DisplayFor(model => item.ReleaseDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.Developer)
            </td>
            <td>
                @Html.DisplayFor(model => item.Publisher)
            </td>
            <td>
                @item.Genre?.Name
            </td>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="@item.Name" style="width: 120px; height: 70px; object-fit: contain;" />
                    }
                    else
                    {
                        <img src="/images/noimage.jpg" alt="No image" style="width: 120px; height: 70px; object-fit: contain;" />
                    }
                </td>
            <td>
                @Html.DisplayFor(model => item.IsPublic)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>