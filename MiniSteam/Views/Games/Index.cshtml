@model IEnumerable<MiniSteam.Models.Entities.Game>

@{
    ViewData["Title"] = "Index";
}

<h1>Games</h1>

<p>
    <a asp-action="Create" class="btn btn-success">
        Create New
    </a>
</p>

<form asp-action="Search" method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <input type="text" name="searchString" class="form-control" placeholder="Search games..." />
    </div>

    <div class="col-md-3">
        <select name="genreId" class="form-select" asp-items="ViewBag.GenreId"> <option value="">All Genres</option> </select>
    </div>

    <div class="col-auto"> 
        <button type="submit" class="btn btn-primary"> Search </button>
        <a asp-action="Index" class="btn btn-secondary"> Clear </a>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Developer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Publisher)
            </th>
            <th>
                Genre
            </th>
            <th>
                Image
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsPublic)
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Description)
            </td>
            <td>
                @Html.DisplayFor(model => item.Price)
            </td>
            <td>
                @Html.DisplayFor(model => item.ReleaseDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.Developer)
            </td>
            <td>
                @Html.DisplayFor(model => item.Publisher)
            </td>
            <td>
                @item.Genre?.Name
            </td>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl"
                             alt="@item.Name"
                             style="width: 120px; height: 70px; object-fit: cover;" />
                    }
                    else
                    {
                        <img src="/images/noimage.jpg"
                             alt="No image"
                             style="width: 120px; height: 70px; object-fit: cover;" />
                    }
                </td>
            <td>
                @Html.DisplayFor(model => item.IsPublic)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

