@model IEnumerable<MiniSteam.Models.Entities.Game>

@{
    ViewData["Title"] = "Games";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="admin-games-header">
    <div>
        <h1>Game Management</h1>
        <p>@Model.Count() games</p>
    </div>

    <a asp-action="Create" class="admin-create-button">Add Game</a>
</div>

<div class="steam-search-bar">
    <form asp-action="Search" method="get" class="steam-search-form">

        <select name="genreId" class="steam-genre-select" asp-items="ViewBag.GenreId"> <option value="">All Genres</option></select>

        <div class="steam-search-box"> <input type="text" name="searchString" value="@Context.Request.Query["searchString"]" placeholder="search the store" />
            <button type="submit" title="Search" class="steam-search-button"><span class="steam-search-icon"></span></button>
        </div>

        <a asp-action="Index" class="steam-clear"> Clear </a>

    </form>
</div>

@if (!Model.Any())
{
    <div class="admin-games-empty">
        <p>No games found.</p>
    </div>
}
else
{
    <div class="admin-games-list">
        @foreach (var item in Model)
        {
            <div class="admin-game-row">
                <div class="admin-game-image">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="@item.Name" />
                    }
                    else
                    {
                        <img src="/images/noimage.jpg" alt="No image" />
                    }
                </div>

                <div class="admin-game-info">
                    <h2>@item.Name</h2>

                    <div class="admin-game-meta">
                        <span>@(item.Genre?.Name ?? "No Genre")</span>
                        <span>@item.Developer</span>
                        <span>@item.Price.ToString("0.00") €</span>
                    </div>

                    <div class="admin-game-status">
                        @if (item.IsPublic)
                        {
                            <span class="game-public">Public</span>
                        }
                        else
                        {
                            <span class="game-hidden">Hidden</span>
                        }
                    </div>
                </div>

                <div class="admin-game-actions">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="admin-edit-button">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" asp-route-from="games" class="admin-details-button">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="admin-delete-button">Delete</a>
                </div>
            </div>
        }
    </div>
}