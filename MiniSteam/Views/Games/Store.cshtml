@model MiniSteam.Models.ViewModels.StoreViewModel
@using MiniSteam.Models.Entities

@{
    ViewData["Title"] = "Store";

    var games = Model.Games;

    var searchString = Context.Request.Query["searchString"].ToString();
    var genreId = Context.Request.Query["genreId"].ToString();
    var tag = (ViewBag.ActiveTag as string) ?? Context.Request.Query["tag"].ToString();
    var developer = (ViewBag.ActiveDeveloper as string) ?? Context.Request.Query["developer"].ToString();
    var publisher = (ViewBag.ActivePublisher as string) ?? Context.Request.Query["publisher"].ToString();
    var activeSection = Model.ActiveSection ?? Context.Request.Query["section"].ToString();

    var hasFilters =
        !string.IsNullOrWhiteSpace(searchString) ||
        !string.IsNullOrWhiteSpace(genreId) ||
        !string.IsNullOrWhiteSpace(tag) ||
        !string.IsNullOrWhiteSpace(developer) ||
        !string.IsNullOrWhiteSpace(publisher) ||
        !string.IsNullOrWhiteSpace(activeSection);

    var sectionTitle = activeSection switch
    {
        "featured" => "Featured Games",
        "specials" => "Special Offers",
        "new" => "New Releases",
        "earlyaccess" => "Early Access",
        "free" => "Free to Play",
        "comingsoon" => "Coming Soon",
        _ => null
    };
}

<div class="store-page store-page-v28">

    <div class="store-page-header">
        <div>
            <span class="store-eyebrow">MINISTEAM STORE</span>
            <h1>Browse Games</h1>
            <p>Discover games, releases and offers available on MiniSteam.</p>
        </div>

        <div class="store-game-count">
            <strong>@games.Count</strong>
            <span>@(games.Count == 1 ? "game" : "games")</span>
        </div>
    </div>

    @if (!hasFilters)
    {
        <div class="store-discovery-nav" aria-label="Store discovery">
            <a asp-action="Store" asp-route-section="featured">Featured</a>
            <a asp-action="Store" asp-route-section="specials">Special Offers</a>
            <a asp-action="Store" asp-route-section="new">New Releases</a>
            <a asp-action="Store" asp-route-section="earlyaccess">Early Access</a>
            <a asp-action="Store" asp-route-section="free">Free to Play</a>
            <a asp-action="Store" asp-route-section="comingsoon">Coming Soon</a>
        </div>

        @if (Model.FeaturedGames.Any())
        {
            <section class="store-shelf-section">
                <div class="store-shelf-heading">
                    <div>
                        <span>DISCOVER</span>
                        <h2>Featured</h2>
                    </div>
                    <a asp-action="Store" asp-route-section="featured">View all</a>
                </div>

                <div class="store-shelf-grid">
                    @foreach (var game in Model.FeaturedGames)
                    {
                        <partial name="_StoreShelfCard" model="game" />
                    }
                </div>
            </section>
        }

        @if (Model.SpecialOfferGames.Any())
        {
            <section class="store-shelf-section">
                <div class="store-shelf-heading">
                    <div>
                        <span>SAVINGS</span>
                        <h2>Special Offers</h2>
                    </div>
                    <a asp-action="Store" asp-route-section="specials">View all</a>
                </div>

                <div class="store-shelf-grid">
                    @foreach (var game in Model.SpecialOfferGames)
                    {
                        <partial name="_StoreShelfCard" model="game" />
                    }
                </div>
            </section>
        }

        @if (Model.NewReleaseGames.Any())
        {
            <section class="store-shelf-section">
                <div class="store-shelf-heading">
                    <div>
                        <span>RECENT</span>
                        <h2>New Releases</h2>
                    </div>
                    <a asp-action="Store" asp-route-section="new">View all</a>
                </div>

                <div class="store-shelf-grid">
                    @foreach (var game in Model.NewReleaseGames)
                    {
                        <partial name="_StoreShelfCard" model="game" />
                    }
                </div>
            </section>
        }

        @if (Model.EarlyAccessGames.Any())
        {
            <section class="store-shelf-section">
                <div class="store-shelf-heading">
                    <div>
                        <span>IN DEVELOPMENT</span>
                        <h2>Early Access</h2>
                    </div>
                    <a asp-action="Store" asp-route-section="earlyaccess">View all</a>
                </div>

                <div class="store-shelf-grid">
                    @foreach (var game in Model.EarlyAccessGames)
                    {
                        <partial name="_StoreShelfCard" model="game" />
                    }
                </div>
            </section>
        }

        @if (Model.FreeGames.Any() || Model.ComingSoonGames.Any())
        {
            <div class="store-discovery-split">
                @if (Model.FreeGames.Any())
                {
                    <section class="store-mini-shelf">
                        <div class="store-shelf-heading">
                            <div>
                                <span>PLAY NOW</span>
                                <h2>Free to Play</h2>
                            </div>
                            <a asp-action="Store" asp-route-section="free">View all</a>
                        </div>

                        @foreach (var game in Model.FreeGames.Take(2))
                        {
                            <partial name="_StoreShelfCard" model="game" />
                        }
                    </section>
                }

                @if (Model.ComingSoonGames.Any())
                {
                    <section class="store-mini-shelf">
                        <div class="store-shelf-heading">
                            <div>
                                <span>NEXT</span>
                                <h2>Coming Soon</h2>
                            </div>
                            <a asp-action="Store" asp-route-section="comingsoon">View all</a>
                        </div>

                        @foreach (var game in Model.ComingSoonGames.Take(2))
                        {
                            <partial name="_StoreShelfCard" model="game" />
                        }
                    </section>
                }
            </div>
        }
    }

    <div class="steam-search-bar">

        <form asp-action="Store"
              method="get"
              class="steam-search-form">

            @if (!string.IsNullOrWhiteSpace(tag))
            {
                <input type="hidden" name="tag" value="@tag" />
            }

            @if (!string.IsNullOrWhiteSpace(developer))
            {
                <input type="hidden" name="developer" value="@developer" />
            }

            @if (!string.IsNullOrWhiteSpace(publisher))
            {
                <input type="hidden" name="publisher" value="@publisher" />
            }

            @if (!string.IsNullOrWhiteSpace(activeSection))
            {
                <input type="hidden" name="section" value="@activeSection" />
            }

            <div class="store-filter-field">
                <span class="store-filter-label">Genre</span>

                <select name="genreId"
                        class="steam-genre-select"
                        asp-items="ViewBag.GenreId">
                    <option value="">All Genres</option>
                </select>
            </div>

            <div class="store-filter-field store-search-field">
                <span class="store-filter-label">Search</span>

                <div class="steam-search-box">
                    <input type="text"
                           name="searchString"
                           value="@searchString"
                           placeholder="Search the store" />

                    <button type="submit"
                            title="Search"
                            class="steam-search-button">
                        <span class="steam-search-icon"></span>
                    </button>
                </div>
            </div>

            @if (hasFilters)
            {
                <a asp-action="Store"
                   class="steam-clear">
                    Clear filters
                </a>
            }

        </form>

        @if (hasFilters)
        {
            <div class="store-active-filters" aria-label="Active store filters">
                <span class="store-active-filters-label">FILTERS</span>

                @if (!string.IsNullOrWhiteSpace(activeSection))
                {
                    <a asp-action="Store"
                       asp-route-searchString="@searchString"
                       asp-route-genreId="@genreId"
                       asp-route-tag="@tag"
                       asp-route-developer="@developer"
                       asp-route-publisher="@publisher"
                       class="store-filter-chip">
                        Section: @sectionTitle <span>×</span>
                    </a>
                }

                @if (!string.IsNullOrWhiteSpace(tag))
                {
                    <a asp-action="Store"
                       asp-route-searchString="@searchString"
                       asp-route-genreId="@genreId"
                       asp-route-developer="@developer"
                       asp-route-publisher="@publisher"
                       asp-route-section="@activeSection"
                       class="store-filter-chip">
                        Tag: @tag <span>×</span>
                    </a>
                }

                @if (!string.IsNullOrWhiteSpace(developer))
                {
                    <a asp-action="Store"
                       asp-route-searchString="@searchString"
                       asp-route-genreId="@genreId"
                       asp-route-tag="@tag"
                       asp-route-publisher="@publisher"
                       asp-route-section="@activeSection"
                       class="store-filter-chip">
                        Developer: @developer <span>×</span>
                    </a>
                }

                @if (!string.IsNullOrWhiteSpace(publisher))
                {
                    <a asp-action="Store"
                       asp-route-searchString="@searchString"
                       asp-route-genreId="@genreId"
                       asp-route-tag="@tag"
                       asp-route-developer="@developer"
                       asp-route-section="@activeSection"
                       class="store-filter-chip">
                        Publisher: @publisher <span>×</span>
                    </a>
                }
            </div>
        }

    </div>

    <div class="store-browse-header">
        <div>
            <span class="store-section-label">BROWSE</span>
            <h2>
                @if (!string.IsNullOrWhiteSpace(sectionTitle))
                {
                    <text>@sectionTitle</text>
                }
                else if (!string.IsNullOrWhiteSpace(tag))
                {
                    <text>Games tagged "@tag"</text>
                }
                else if (!string.IsNullOrWhiteSpace(developer))
                {
                    <text>Games by @developer</text>
                }
                else if (!string.IsNullOrWhiteSpace(publisher))
                {
                    <text>Published by @publisher</text>
                }
                else if (hasFilters)
                {
                    <text>Search Results</text>
                }
                else
                {
                    <text>All Games</text>
                }
            </h2>
        </div>

        <span class="store-result-count">
            @games.Count @(games.Count == 1 ? "result" : "results")
        </span>
    </div>

    <div class="store-results">

        @if (!games.Any())
        {
            <div class="store-no-results">

                <div class="store-no-results-icon">?</div>

                <h3>No games found</h3>

                <p>
                    We couldn't find anything matching the current filters.
                    Try another title, genre, tag, developer or store section.
                </p>

                <a asp-action="Store"
                   class="store-reset-button">
                    View all games
                </a>

            </div>
        }
        else
        {
            @foreach (var game in games)
            {
                <a asp-action="Details"
                   asp-route-id="@game.Id"
                   asp-route-from="store"
                   class="store-game-row">

                    <div class="store-game-image">
                        <img src="@(string.IsNullOrWhiteSpace(game.ImageUrl) ? "/images/noimage.jpg" : game.ImageUrl)"
                             alt="@game.Name" />
                    </div>

                    <div class="store-game-info">

                        <div class="store-game-title-line">
                            <h4>@game.Name</h4>

                            @if (game.IsFeatured)
                            {
                                <span class="store-state-badge store-state-featured">FEATURED</span>
                            }

                            @if (game.ReleaseStatus == GameReleaseStatus.ComingSoon)
                            {
                                <span class="store-state-badge store-state-coming">COMING SOON</span>
                            }
                            else if (game.ReleaseStatus == GameReleaseStatus.EarlyAccess)
                            {
                                <span class="store-state-badge store-state-early">EARLY ACCESS</span>
                            }
                        </div>

                        <div class="store-game-meta">

                            @if (game.Genre != null)
                            {
                                <span class="store-game-genre">
                                    @game.Genre.Name
                                </span>
                            }

                            @if (!string.IsNullOrWhiteSpace(game.Developer))
                            {
                                <span class="store-game-developer">
                                    @game.Developer
                                </span>
                            }

                        </div>

                        @if (game.Tags.Any())
                        {
                            <div class="store-game-tags">
                                @foreach (var gameTag in game.Tags.OrderBy(item => item.Name).Take(3))
                                {
                                    <span>@gameTag.Name</span>
                                }
                            </div>
                        }

                        <span class="store-game-date">
                            @if (game.ReleaseStatus == GameReleaseStatus.ComingSoon)
                            {
                                <text>Coming @game.ReleaseDate.ToString("dd MMM yyyy")</text>
                            }
                            else if (game.ReleaseStatus == GameReleaseStatus.EarlyAccess)
                            {
                                <text>Early Access · @game.ReleaseDate.ToString("dd MMM yyyy")</text>
                            }
                            else
                            {
                                <text>Released @game.ReleaseDate.ToString("dd MMM yyyy")</text>
                            }
                        </span>

                    </div>

                    <div class="store-game-price-area">

                        @if (game.ReleaseStatus == GameReleaseStatus.ComingSoon)
                        {
                            <span class="store-coming-price">Wishlist now</span>
                        }
                        else if (game.Price == 0)
                        {
                            <span class="store-game-price-free">
                                Free
                            </span>
                        }
                        else if (game.HasDiscount)
                        {
                            <div class="store-sale-price">
                                <span class="store-discount-badge">-@game.ActiveDiscountPercent%</span>
                                <span class="store-old-price">@game.Price.ToString("0.00") €</span>
                                <span class="store-game-price-value">@game.FinalPrice.ToString("0.00") €</span>
                            </div>
                        }
                        else
                        {
                            <span class="store-game-price-value">
                                @game.FinalPrice.ToString("0.00") €
                            </span>
                        }

                    </div>

                </a>
            }
        }

    </div>

</div>
