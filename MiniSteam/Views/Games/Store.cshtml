@model IEnumerable<MiniSteam.Models.Entities.Game>

@{
    ViewData["Title"] = "Store";
}

<h1>Store</h1>

<div class="steam-search-bar">
    <form asp-action="Store" method="get" class="steam-search-form">
        <select name="genreId" class="steam-genre-select" asp-items="ViewBag.GenreId"><option value="">All Genres</option></select>

        <div class="steam-search-box">
            <input type="text" name="searchString" value="@Context.Request.Query["searchString"]" placeholder="search the store" />
            <button type="submit" title="Search" class="steam-search-button"><span class="steam-search-icon"></span></button>
        </div>

        <a asp-action="Store" class="steam-clear">Clear</a>
    </form>
</div>

<div class="store-results">
    @if (!Model.Any())
    {
        <div class="store-no-results">
            <h4>No games found</h4>
            <p>Try another search or genre.</p>
        </div>
    }
    else
    {
        @foreach (var game in Model)
        {
            <a asp-action="Details" asp-route-id="@game.Id" asp-route-from="store" class="store-game-row">
                <div class="store-game-image">
                    @if (!string.IsNullOrEmpty(game.ImageUrl))
                    {
                        <img src="@game.ImageUrl" alt="@game.Name" />
                    }
                    else
                    {
                        <img src="/images/noimage.jpg" alt="No image" />
                    }
                </div>

                <div class="store-game-info">
                    <h4>@game.Name</h4>
                    <span>@game.Genre?.Name</span>
                </div>

                <div class="store-game-price">
                    @game.Price.ToString("0.00") €
                </div>
            </a>
        }
    }
</div>