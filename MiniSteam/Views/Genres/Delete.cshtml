@model MiniSteam.Models.Entities.Genre

@{
    ViewData["Title"] = "Delete Genre";
}

<div class="genre-delete-page">

    <div class="genre-editor-navigation">

        <a asp-action="Index">
            ← Back to Genre Management
        </a>

        <span>
            GENRE ID @Model.Id
        </span>

    </div>


    <div class="genre-delete-card">

        <div class="genre-delete-icon">
            !
        </div>

        <span class="genre-delete-eyebrow">
            DESTRUCTIVE ACTION
        </span>

        <h1>Delete Genre?</h1>

        <p class="genre-delete-description">
            You are about to remove this category from MiniSteam.
        </p>


        <div class="genre-delete-preview">

            <div class="genre-delete-symbol">
                #
            </div>

            <div>

                <span>
                    GENRE ID @Model.Id
                </span>

                <h2>
                    @Model.Name
                </h2>

                <p>
                    MiniSteam Store category
                </p>

            </div>

        </div>


        <div class="genre-delete-warning">

            <span>!</span>

            <div>

                <strong>
                    This action may be blocked
                </strong>

                <p>
                    A genre that is currently used by one or more games cannot be deleted.
                </p>

            </div>

        </div>


        <form asp-action="Delete"
              method="post"
              class="genre-delete-actions">

            <input type="hidden"
                   asp-for="Id" />

            <a asp-action="Index"
               class="genre-delete-cancel">
                Cancel
            </a>

            <button type="submit"
                    class="genre-delete-confirm">
                Delete Genre
            </button>

        </form>

    </div>

</div>