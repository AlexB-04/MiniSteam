@model MiniSteam.Models.Entities.Genre

@{
    ViewData["Title"] = "Genre Details";
}

<div class="genre-details-page">

    <div class="genre-editor-navigation">

        <a asp-action="Index">
            ← Back to Genre Management
        </a>

        <span>
            GENRE ID @Model.Id
        </span>

    </div>


    <div class="genre-details-card">

        <div class="genre-details-symbol">
            #
        </div>

        <span class="genre-admin-eyebrow">
            STORE CATEGORY
        </span>

        <h1>@Model.Name</h1>

        <p>
            This genre can be assigned to games and used when browsing the MiniSteam Store.
        </p>


        <div class="genre-details-data">

            <div>

                <span>GENRE ID</span>

                <strong>
                    @Model.Id
                </strong>

            </div>


            <div>

                <span>NAME</span>

                <strong>
                    @Model.Name
                </strong>

            </div>


            <div>

                <span>TYPE</span>

                <strong>
                    Store Category
                </strong>

            </div>

        </div>


        <div class="genre-details-actions">

            <a asp-action="Index"
               class="genre-details-back">
                Back
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="genre-details-edit">
                Edit Genre
            </a>

        </div>

    </div>

</div>