@model MiniSteam.Models.Entities.Genre

@{
    ViewData["Title"] = "Genre Details";
}

<div class="genre-form-page">
    <div class="genre-form-card">
        <h1>Genre Details</h1>

        <div class="genre-details-row">
            <span>Name</span>
            <strong>@Model.Name</strong>
        </div>

        <div class="genre-form-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="admin-edit-button">Edit</a>
            <a asp-action="Index" class="admin-details-button">Back to List</a>
        </div>
    </div>
</div>