@model MiniSteam.Models.Entities.Genre

@{
    ViewData["Title"] = "Edit Genre";
}

<div class="genre-form-page">
    <div class="genre-form-card">
        <h1>Edit Genre</h1>

        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="genre-form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="genre-form-actions">
                <button type="submit" class="admin-edit-button genre-save-button">Save</button>
                <a asp-action="Index" class="admin-details-button">Back to List</a>
            </div>
        </form>
    </div>
</div>