@model MiniSteam.Models.Entities.Genre

@{
    ViewData["Title"] = "Edit Genre";
}

<div class="genre-editor-page">

    <div class="genre-editor-navigation">

        <a asp-action="Index">
            ← Back to Genre Management
        </a>

        <span>
            GENRE ID @Model.Id
        </span>

    </div>


    <div class="genre-editor-heading">

        <span class="genre-admin-eyebrow">
            EDIT CATEGORY
        </span>

        <h1>@Model.Name</h1>

        <p>Update this MiniSteam Store category.</p>

    </div>


    <div class="genre-editor-layout">

        <form asp-action="Edit"
              method="post"
              class="genre-editor-card">

            <input type="hidden"
                   asp-for="Id" />


            <div asp-validation-summary="ModelOnly"
                 class="genre-editor-validation">
            </div>


            <div class="genre-editor-section-heading">

                <span>01</span>

                <div>
                    <h2>Genre Information</h2>
                    <p>Edit the name used in the MiniSteam Store.</p>
                </div>

            </div>


            <div class="genre-editor-field">

                <label asp-for="Name">
                    Genre Name
                </label>

                <input asp-for="Name"
                       class="genre-editor-input" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>

            </div>


            <div class="genre-editor-actions">

                <a asp-action="Index"
                   class="genre-editor-cancel">
                    Cancel
                </a>

                <button type="submit"
                        class="genre-editor-save">
                    Save Changes
                </button>

            </div>

        </form>


        <aside class="genre-editor-help">

            <span class="genre-editor-help-label">
                GENRE ID @Model.Id
            </span>

            <h2>Store Category</h2>

            <p>
                Changing the name updates how this genre is displayed wherever it is used in MiniSteam.
            </p>


            <div class="genre-editor-current">

                <span>CURRENT NAME</span>

                <strong>@Model.Name</strong>

            </div>

        </aside>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}