@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="privacy-page">

    <div class="privacy-header">

        <span class="privacy-eyebrow">
            MINISTEAM
        </span>

        <h1>Privacy Policy</h1>

        <p>
            This page explains what information MiniSteam uses
            to provide account and store features.
        </p>

        <span class="privacy-updated">
            Last updated: 28 August 2026
        </span>

    </div>


    <div class="privacy-layout">

        <aside class="privacy-sidebar">

            <span class="privacy-sidebar-label">
                OVERVIEW
            </span>

            <div class="privacy-sidebar-item">
                <span>01</span>
                Account Information
            </div>

            <div class="privacy-sidebar-item">
                <span>02</span>
                Store Activity
            </div>

            <div class="privacy-sidebar-item">
                <span>03</span>
                Reviews
            </div>

            <div class="privacy-sidebar-item">
                <span>04</span>
                Password Recovery
            </div>

            <div class="privacy-sidebar-item">
                <span>05</span>
                Project Scope
            </div>

        </aside>


        <div class="privacy-content">

            <section class="privacy-section">

                <div class="privacy-section-number">
                    01
                </div>

                <div>

                    <h2>Account Information</h2>

                    <p>
                        MiniSteam uses account information such as your
                        email address to identify your account and allow
                        you to sign in.
                    </p>

                    <p>
                        Authentication is handled through ASP.NET Core
                        Identity. Your account is used to associate
                        MiniSteam features with the correct user.
                    </p>

                </div>

            </section>


            <section class="privacy-section">

                <div class="privacy-section-number">
                    02
                </div>

                <div>

                    <h2>Store and Library Activity</h2>

                    <p>
                        When you use MiniSteam, the application may store
                        information required for features such as:
                    </p>

                    <div class="privacy-data-grid">

                        <div>
                            <span>LIBRARY</span>
                            <strong>Games you own</strong>
                        </div>

                        <div>
                            <span>WISHLIST</span>
                            <strong>Games you save</strong>
                        </div>

                        <div>
                            <span>PURCHASES</span>
                            <strong>Purchase history</strong>
                        </div>

                        <div>
                            <span>TIMESTAMPS</span>
                            <strong>Relevant activity dates</strong>
                        </div>

                    </div>

                    <p>
                        Purchase records preserve information such as the
                        game and its price at the time of the transaction.
                    </p>

                </div>

            </section>


            <section class="privacy-section">

                <div class="privacy-section-number">
                    03
                </div>

                <div>

                    <h2>User Reviews</h2>

                    <p>
                        If you publish a review, MiniSteam stores the review
                        text, your recommendation choice and relevant
                        creation or update dates.
                    </p>

                    <p>
                        Reviews are displayed publicly on game pages.
                        MiniSteam currently presents reviewers as
                        “MiniSteam User” or “You” rather than publicly
                        displaying their email address.
                    </p>

                </div>

            </section>


            <section class="privacy-section">

                <div class="privacy-section-number">
                    04
                </div>

                <div>

                    <h2>Password Recovery</h2>

                    <p>
                        If you request a password reset, MiniSteam can send
                        password recovery instructions to the email address
                        associated with your account.
                    </p>

                    <p>
                        The recovery page does not confirm whether a submitted
                        email address belongs to an existing MiniSteam account.
                    </p>

                </div>

            </section>


            <section class="privacy-section">

                <div class="privacy-section-number">
                    05
                </div>

                <div>

                    <h2>Educational Project Scope</h2>

                    <p>
                        MiniSteam is an educational game-store project.
                        It is not affiliated with Valve Corporation or Steam.
                    </p>

                    <p>
                        The current version does not process real payment-card
                        transactions. Store purchases in MiniSteam are part of
                        the application's own demonstration and learning system.
                    </p>

                </div>

            </section>


            <div class="privacy-notice">

                <span class="privacy-notice-icon">
                    i
                </span>

                <div>
                    <strong>About this policy</strong>

                    <span>
                        This page describes the current functionality of the
                        MiniSteam project and is not intended to imitate
                        Valve's legal privacy policy.
                    </span>
                </div>

            </div>

        </div>

    </div>

</div>