@model IEnumerable<MiniSteam.Models.Entities.Purchase>

@{
    ViewData["Title"] = "Purchase History";

    var purchases = Model
        .OrderByDescending(purchase => purchase.PurchasedAt)
        .ToList();

    var totalSpent = purchases
        .Where(purchase => purchase.Payment?.Status != MiniSteam.Models.Entities.PaymentStatus.Refunded)
        .Sum(purchase => purchase.TotalPrice);
    var totalGames = purchases.Sum(purchase => purchase.PurchaseItems.Count);
}

<div class="purchase-page-v2">

    <div class="purchase-v2-header">

        <div>
            <span class="purchase-eyebrow">ACCOUNT</span>
            <h1>Purchase History</h1>
            <p>Review games purchased through your MiniSteam account.</p>
        </div>

        <a asp-controller="Games"
           asp-action="Store"
           class="purchase-store-button">
            Browse Store
        </a>

    </div>


    @if (!purchases.Any())
    {
        <div class="purchase-empty-v2">

            <div class="purchase-empty-icon">€</div>

            <span class="purchase-empty-label">
                PURCHASE HISTORY
            </span>

            <h2>No purchases yet</h2>

            <p>
                Games you purchase on MiniSteam will appear here.
            </p>

            <a asp-controller="Games"
               asp-action="Store"
               class="purchase-store-button">
                Browse the Store
            </a>

        </div>
    }
    else
    {
        <div class="purchase-summary">

            <div class="purchase-summary-card">
                <span class="purchase-summary-label">
                    PURCHASES
                </span>

                <strong>@purchases.Count</strong>

                <small>
                    @(purchases.Count == 1 ? "transaction" : "transactions")
                </small>
            </div>


            <div class="purchase-summary-card">
                <span class="purchase-summary-label">
                    GAMES
                </span>

                <strong>@totalGames</strong>

                <small>
                    purchased
                </small>
            </div>


            <div class="purchase-summary-card purchase-summary-total">
                <span class="purchase-summary-label">
                    TOTAL SPENT
                </span>

                <strong>@totalSpent.ToString("0.00") €</strong>

                <small>
                    through MiniSteam
                </small>
            </div>

        </div>


        <section class="purchase-history-section">

            <div class="purchase-section-header">

                <div>
                    <span class="purchase-section-eyebrow">
                        TRANSACTIONS
                    </span>

                    <h2>Your Purchases</h2>
                </div>

                <span class="purchase-section-count">
                    @purchases.Count @(purchases.Count == 1 ? "purchase" : "purchases")
                </span>

            </div>


            <div class="purchase-list">

                @foreach (var purchase in purchases)
                {
                    <article class="purchase-card purchase-card-v2">

                        <div class="purchase-card-header purchase-card-header-v2">

                            <div class="purchase-transaction-info">

                                <div class="purchase-transaction-icon">
                                    ✓
                                </div>

                                <div>
                                    <span class="purchase-transaction-label">
                                        @(purchase.Payment?.Status == MiniSteam.Models.Entities.PaymentStatus.Refunded ? "REFUNDED PURCHASE" : "PURCHASE")
                                    </span>

                                    <strong>
                                        Transaction #@purchase.Id
                                    </strong>

                                    <span class="purchase-transaction-date">
                                        @purchase.PurchasedAt.ToString("dd MMM yyyy · HH:mm")
                                    </span>
                                </div>

                            </div>


                            <div class="purchase-transaction-total">

                                <span>Total</span>

                                @if (purchase.Payment?.Status == MiniSteam.Models.Entities.PaymentStatus.Refunded)
                                {
                                    <strong class="purchase-free">Refunded</strong>
                                    <small>@purchase.TotalPrice.ToString("0.00") € historical</small>
                                }
                                else if (purchase.TotalPrice == 0)
                                {
                                    <strong class="purchase-free">
                                        Free
                                    </strong>
                                }
                                else
                                {
                                    <strong>
                                        @purchase.TotalPrice.ToString("0.00") €
                                    </strong>
                                }

                            </div>

                        </div>


                        <div class="purchase-items">

                            @foreach (var item in purchase.PurchaseItems)
                            {
                                <div class="purchase-item purchase-item-v2">

                                    <a asp-controller="Games"
                                       asp-action="Details"
                                       asp-route-id="@item.GameId"
                                       asp-route-from="library"
                                       class="purchase-game-link">

                                        <div class="purchase-game-image">

                                            @if (!string.IsNullOrEmpty(item.Game.ImageUrl))
                                            {
                                                <img src="@item.Game.ImageUrl"
                                                     alt="@item.Game.Name" />
                                            }
                                            else
                                            {
                                                <img src="~/images/noimage.jpg"
                                                     alt="No image available" />
                                            }

                                        </div>


                                        <div class="purchase-game-info">

                                            <strong>
                                                @item.Game.Name
                                            </strong>

                                            <span>
                                                @item.Game.Developer
                                            </span>

                                            <small>
                                                View in your library
                                            </small>

                                        </div>

                                    </a>


                                    <div class="purchase-item-price">

                                        @if (item.Price == 0)
                                        {
                                            <span class="purchase-free">
                                                Free
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                @item.Price.ToString("0.00") €
                                            </span>
                                        }

                                    </div>

                                </div>
                            }

                        </div>


                        <div class="purchase-card-footer">

                            <span>
                                @purchase.PurchaseItems.Count
                                @(purchase.PurchaseItems.Count == 1 ? "item" : "items")
                            </span>

                            <span>
                                @if (purchase.Payment?.Status == MiniSteam.Models.Entities.PaymentStatus.Refunded)
                                {
                                    <text>Refunded @purchase.Payment.RefundedAt?.ToString("dd MMM yyyy")</text>
                                }
                                else
                                {
                                    <text>Purchased @purchase.PurchasedAt.ToString("dd MMM yyyy")</text>
                                }
                            </span>

                        </div>

                    </article>
                }

            </div>

        </section>
    }

</div>