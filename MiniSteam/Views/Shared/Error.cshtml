@model ErrorViewModel

@{
    ViewData["Title"] = "Something Went Wrong";
}

<div class="error-page">

    <div class="error-card">

        <div class="error-symbol">
            !
        </div>

        <span class="error-eyebrow">MINISTEAM ERROR</span>

        <h1>Something Went Wrong</h1>

        <p class="error-description">
            MiniSteam could not complete your request.
            The problem may be temporary, so you can return to the Store and try again.
        </p>

        <div class="error-info-box">

            <span class="error-info-icon">i</span>

            <div>
                <strong>The request could not be completed normally</strong>
                <span>If you were completing an action, check the relevant page before trying again.</span>
            </div>

        </div>

        @if (Model.ShowRequestId)
        {
            <div class="error-request">

                <span>REQUEST ID</span>

                <code>@Model.RequestId</code>

            </div>
        }

        <div class="error-actions">

            <a asp-controller="Games" asp-action="Store" class="error-primary-button">Return to Store</a>

            <a asp-controller="Home" asp-action="Index" class="error-secondary-button">MiniSteam Home</a>

        </div>

        <span class="error-code">ERROR 500</span>

    </div>

</div>