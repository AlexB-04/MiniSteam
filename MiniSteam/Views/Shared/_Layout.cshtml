@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var storeActive =
        currentController == "Games" &&
        currentAction == "Store";

    var libraryActive =
        currentController == "Library";

    var wishlistActive =
        currentController == "Wishlist";

    var adminActive =
        User.IsInRole("Admin") &&
        (
            (currentController == "Games" &&
             currentAction != "Store" &&
             currentAction != "Details")
            ||
            currentController == "Genres"
        );
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MiniSteam</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <header class="mini-global-header">
        <nav class="navbar navbar-expand-md mini-navbar">
            <div class="container mini-navbar-container">

                <a class="mini-brand" asp-controller="Home" asp-action="Index">
                    <span class="mini-brand-logo">M</span>

                    <span class="mini-brand-name">
                        MINI<span>STEAM</span>
                    </span>
                </a>

                <button class="navbar-toggler mini-navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#miniSteamNavbar"
                        aria-controls="miniSteamNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="mini-menu-icon">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>
                </button>

                <div class="collapse navbar-collapse" id="miniSteamNavbar">

                    <ul class="navbar-nav mini-main-nav">

                        <li class="nav-item">
                            <a class="mini-nav-link @(storeActive ? "active" : "")"
                               asp-controller="Games"
                               asp-action="Store">
                                STORE
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="mini-nav-link @(libraryActive ? "active" : "")"
                                   asp-controller="Library"
                                   asp-action="Index">
                                    LIBRARY
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="mini-nav-link @(wishlistActive ? "active" : "")"
                                   asp-controller="Wishlist"
                                   asp-action="Index">
                                    WISHLIST
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <button class="mini-nav-link mini-nav-dropdown @(adminActive ? "active" : "")"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    ADMIN
                                    <span class="mini-dropdown-arrow">▾</span>
                                </button>

                                <ul class="dropdown-menu mini-dropdown-menu">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Games"
                                           asp-action="Index">
                                            Manage Games
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Games"
                                           asp-action="Create">
                                            Add Game
                                        </a>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Genres"
                                           asp-action="Index">
                                            Manage Genres
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                    </ul>

                    <div class="mini-account-area">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">

                                <button class="mini-user-button"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    <span class="mini-user-avatar">
                                        @(User.Identity.Name?.Substring(0, 1).ToUpper())
                                    </span>

                                    <span class="mini-user-info">
                                        <span class="mini-user-name">@User.Identity.Name</span>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <span class="mini-user-role">Administrator</span>
                                        }
                                        else
                                        {
                                            <span class="mini-user-role">MiniSteam User</span>
                                        }
                                    </span>

                                    <span class="mini-dropdown-arrow">▾</span>
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end mini-dropdown-menu mini-account-menu">

                                    <li class="mini-account-menu-header">
                                        <span>ACCOUNT</span>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Purchase"
                                           asp-action="History">
                                            Purchase History
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Account"
                                           asp-action="ChangePassword">
                                            Change Password
                                        </a>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <form asp-controller="Account"
                                              asp-action="Logout"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="dropdown-item mini-logout-button">
                                                Sign Out
                                            </button>
                                        </form>
                                    </li>

                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="mini-login-link"
                               asp-controller="Account"
                               asp-action="Login">
                                LOGIN
                            </a>

                            <a class="mini-register-button"
                               asp-controller="Account"
                               asp-action="Register">
                                JOIN MINISTEAM
                            </a>
                        }

                    </div>

                </div>
            </div>
        </nav>

        <div class="mini-header-glow"></div>
    </header>


    <div class="container mini-content-container">
        <main role="main">
            @RenderBody()
        </main>
    </div>


    <footer class="mini-footer">
        <div class="container mini-footer-container">

            <div class="mini-footer-brand">
                <span class="mini-footer-logo">M</span>

                <div>
                    <strong>MiniSteam</strong>
                    <span>Educational game store project</span>
                </div>
            </div>

            <div class="mini-footer-links">
                <span>&copy; 2026 MiniSteam</span>

                <a asp-controller="Home"
                   asp-action="Privacy">
                    Privacy
                </a>

                <a asp-controller="Games"
                   asp-action="Store">
                    Store
                </a>
            </div>

        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>