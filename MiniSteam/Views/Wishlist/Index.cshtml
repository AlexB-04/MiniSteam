@model IEnumerable<MiniSteam.Models.Entities.WishlistItem>

@{
    ViewData["Title"] = "Wishlist";

    var wishlistItems = Model
        .OrderByDescending(item => item.AddedAt)
        .ToList();

    var ownedGameIds = ViewBag.OwnedGameIds as System.Collections.Generic.List<int> ?? new System.Collections.Generic.List<int>();
    var cartGameIds = ViewBag.CartGameIds as System.Collections.Generic.List<int> ?? new System.Collections.Generic.List<int>();
}

<div class="wishlist-page">

    @if (TempData["CartMessage"] != null)
    {
        <div class="wishlist-status-message">
            @TempData["CartMessage"]
        </div>
    }

    @if (TempData["WishlistMessage"] != null)
    {
        <div class="wishlist-status-message">
            @TempData["WishlistMessage"]
        </div>
    }

    <div class="wishlist-header">
        <div>
            <span class="wishlist-eyebrow">YOUR PICKS</span>
            <h1>Wishlist</h1>
            <p>Games you want to keep an eye on.</p>
        </div>

        <div class="wishlist-header-actions">
            <div class="wishlist-count-card">
                <strong>@wishlistItems.Count</strong>
                <span>@(wishlistItems.Count == 1 ? "game" : "games")</span>
            </div>

            <a asp-controller="Games" asp-action="Store" class="library-store-button">Browse Store</a>
        </div>
    </div>


    @if (!wishlistItems.Any())
    {
        <div class="wishlist-empty">

            <div class="wishlist-empty-icon">♡</div>

            <span class="wishlist-empty-label">YOUR WISHLIST</span>

            <h2>Your wishlist is empty</h2>

            <p>Save games that interest you and they will appear here.</p>

            <a asp-controller="Games" asp-action="Store" class="library-store-button">Explore the Store</a>

        </div>
    }
    else
    {
        <div class="wishlist-toolbar">

            <div class="wishlist-search-box">
                <span class="wishlist-search-icon"></span>
                <input id="wishlistSearch" type="text" placeholder="Search your wishlist" autocomplete="off" />
                <button id="wishlistSearchClear" type="button" title="Clear search">×</button>
            </div>

            <div class="wishlist-sort-area">
                <span>Sort by</span>

                <select id="wishlistSort">
                    <option value="added-desc">Date Added</option>
                    <option value="name-asc">Name</option>
                    <option value="price-asc">Price: Low to High</option>
                    <option value="price-desc">Price: High to Low</option>
                    <option value="release-desc">Release Date</option>
                </select>
            </div>

        </div>


        <div id="wishlistNoResults" class="wishlist-search-empty" hidden>
            <h3>No games found</h3>
            <p>No games in your wishlist match that search.</p>
        </div>


        <div id="wishlistGameList" class="wishlist-list">

            @foreach (var item in wishlistItems)
            {
                var isFree = item.Game.Price == 0;
                var isUpcoming = item.Game.ReleaseDate.Date > DateTime.Today;
                var isOwned = ownedGameIds.Contains(item.GameId);
                var isInCart = cartGameIds.Contains(item.GameId);

                <article class="wishlist-row"
                         data-game-name="@item.Game.Name.ToLowerInvariant()"
                         data-game-developer="@item.Game.Developer.ToLowerInvariant()"
                         data-price="@item.Game.FinalPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                         data-added="@item.AddedAt.ToString("O")"
                         data-release="@item.Game.ReleaseDate.ToString("O")">

                    <a asp-controller="Games" asp-action="Details" asp-route-id="@item.GameId" asp-route-from="wishlist" class="wishlist-game-main">

                        <div class="wishlist-game-image">

                            @if (!string.IsNullOrEmpty(item.Game.ImageUrl))
                            {
                                <img src="@item.Game.ImageUrl" alt="@item.Game.Name" />
                            }
                            else
                            {
                                <img src="~/images/noimage.jpg" alt="No image available" />
                            }

                        </div>


                        <div class="wishlist-game-info">

                            <h2>@item.Game.Name</h2>

                            <span class="wishlist-developer">@item.Game.Developer</span>

                            @if (isUpcoming)
                            {
                                <span class="wishlist-release-date">Releases @item.Game.ReleaseDate.ToString("dd MMM yyyy")</span>
                            }
                            else
                            {
                                <span class="wishlist-release-date">Released @item.Game.ReleaseDate.ToString("dd MMM yyyy")</span>
                            }

                            <span class="wishlist-added-date">Added to wishlist @item.AddedAt.ToString("dd MMM yyyy")</span>

                        </div>

                    </a>


                    <div class="wishlist-side">

                        <div class="wishlist-price">

                            @if (isFree)
                            {
                                <span class="wishlist-free">Free</span>
                            }
                            else if (item.Game.HasDiscount)
                            {
                                <div class="wishlist-sale-price">
                                    <span class="wishlist-discount-badge">-@item.Game.DiscountPercent%</span>
                                    <span class="wishlist-old-price">@item.Game.Price.ToString("0.00") €</span>
                                    <span>@item.Game.FinalPrice.ToString("0.00") €</span>
                                </div>
                            }
                            else
                            {
                                <span>@item.Game.FinalPrice.ToString("0.00") €</span>
                            }

                        </div>


                        <div class="wishlist-actions">

                            @if (isOwned)
                            {
                                <button type="button" class="wishlist-owned-button" disabled>In Library</button>
                            }
                            else if (isFree)
                            {
                                <form asp-controller="Purchase" asp-action="Buy" asp-route-gameId="@item.GameId" method="post">
                                    <button type="submit" class="wishlist-buy-button">Get Game</button>
                                </form>
                            }
                            else if (isInCart)
                            {
                                <a asp-controller="Cart" asp-action="Index" class="wishlist-cart-button">View Cart</a>
                            }
                            else
                            {
                                <form asp-controller="Cart"
                                      asp-action="Add"
                                      asp-route-gameId="@item.GameId"
                                      asp-route-returnUrl="@Url.Action("Index", "Wishlist")"
                                      method="post">
                                    <button type="submit" class="wishlist-buy-button">Add to Cart</button>
                                </form>
                            }

                            <a asp-controller="Wishlist" asp-action="RemoveFromWishlist" asp-route-gameId="@item.GameId" class="wishlist-remove-button">Remove</a>

                        </div>

                    </div>

                </article>
            }

        </div>
    }

</div>


@section Scripts {
    <script>
        const wishlistSearch = document.getElementById("wishlistSearch");
        const wishlistSearchClear = document.getElementById("wishlistSearchClear");
        const wishlistSort = document.getElementById("wishlistSort");
        const wishlistGameList = document.getElementById("wishlistGameList");
        const wishlistNoResults = document.getElementById("wishlistNoResults");

        if (wishlistGameList) {
            const getWishlistRows = () =>
                Array.from(wishlistGameList.querySelectorAll(".wishlist-row"));

            function filterWishlist() {
                const searchValue = wishlistSearch?.value.trim().toLowerCase() ?? "";
                let visibleGames = 0;

                getWishlistRows().forEach(gameRow => {
                    const gameName = gameRow.dataset.gameName ?? "";
                    const gameDeveloper = gameRow.dataset.gameDeveloper ?? "";

                    const matches =
                        gameName.includes(searchValue) ||
                        gameDeveloper.includes(searchValue);

                    gameRow.hidden = !matches;

                    if (matches) {
                        visibleGames++;
                    }
                });

                if (wishlistNoResults) {
                    wishlistNoResults.hidden = visibleGames !== 0;
                }

                wishlistSearchClear?.classList.toggle("visible", searchValue.length > 0);
            }


            function sortWishlist() {
                const sortValue = wishlistSort?.value ?? "added-desc";
                const rows = getWishlistRows();

                rows.sort((firstGame, secondGame) => {
                    const firstName = firstGame.dataset.gameName ?? "";
                    const secondName = secondGame.dataset.gameName ?? "";

                    const firstPrice = Number(firstGame.dataset.price ?? 0);
                    const secondPrice = Number(secondGame.dataset.price ?? 0);

                    const firstAdded = new Date(firstGame.dataset.added ?? 0);
                    const secondAdded = new Date(secondGame.dataset.added ?? 0);

                    const firstRelease = new Date(firstGame.dataset.release ?? 0);
                    const secondRelease = new Date(secondGame.dataset.release ?? 0);

                    switch (sortValue) {
                        case "name-asc":
                            return firstName.localeCompare(secondName);

                        case "price-asc":
                            return firstPrice - secondPrice;

                        case "price-desc":
                            return secondPrice - firstPrice;

                        case "release-desc":
                            return secondRelease - firstRelease;

                        default:
                            return secondAdded - firstAdded;
                    }
                });

                rows.forEach(gameRow => wishlistGameList.appendChild(gameRow));
            }


            wishlistSearch?.addEventListener("input", filterWishlist);

            wishlistSearchClear?.addEventListener("click", function() {
                wishlistSearch.value = "";
                filterWishlist();
                wishlistSearch.focus();
            });

            wishlistSort?.addEventListener("change", sortWishlist);
        }
    </script>
}